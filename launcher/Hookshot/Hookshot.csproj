<!-- The Hookshot launcher, one app for Windows and Linux (Avalonia 11.3, which builds with the .NET 8 SDK CI uses: Skia draws it the same on both). It shares the WPF launcher's
     rules as they are (builder/HookshotBuilder: LaunchList.cs, LaunchWork.cs, GameEnv.cs, ShaderStep.cs, Strings.cs, BuildWorkers.cs,
     BuilderSettings.cs) while it takes its place -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hookshot</AssemblyName>
    <RootNamespace>Hookshot.Launcher</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\builder\HookshotBuilder\LaunchList.cs" Link="Shared\LaunchList.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\LaunchWork.cs" Link="Shared\LaunchWork.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\GameEnv.cs" Link="Shared\GameEnv.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\ShaderStep.cs" Link="Shared\ShaderStep.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\Strings.cs" Link="Shared\Strings.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\BuildWorkers.cs" Link="Shared\BuildWorkers.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\BuilderSettings.cs" Link="Shared\BuilderSettings.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\BuilderHome.cs" Link="Shared\BuilderHome.cs" />
    <Compile Include="..\..\builder\HookshotBuilder\FfxRuntime.cs" Link="Shared\FfxRuntime.cs" />
    <!-- (the Linux game folder's starter, which opens this launcher first: Builders.RefreshStarter puts it in each folder built) -->
    <EmbeddedResource Include="..\..\builder\linux\hookshot-folder" LogicalName="hookshot-folder" />
    <AvaloniaResource Include="..\..\builder\HookshotBuilder\Images\hookshot.png" Link="Assets\hookshot.png" />
    <AvaloniaResource Include="..\..\builder\HookshotBuilder\Fonts\Marcellus-Regular.ttf" Link="Assets\Fonts\Marcellus-Regular.ttf" />
  </ItemGroup>
  <!-- Controller support (Input/Gamepad.cs) reads pads through SDL2 (zlib-licensed) from Ultz.Native.SDL, the .NET Foundation's (Silk.NET's)
       natives-only SDL2 build, no managed code. Package 2.32.10 holds SDL release-2.30.8 for Windows and release-2.32.8 for Linux. Only the
       target OS's library is copied beside the launcher, none of the package's other platforms; without it there's just no controller support -->
  <ItemGroup Label="Gamepad">
    <PackageReference Include="Ultz.Native.SDL" Version="2.32.10" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <Content Include="$(PkgUltz_Native_SDL)/runtimes/win-x64/native/SDL2.dll" Link="SDL2.dll" ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))" />
    <Content Include="$(PkgUltz_Native_SDL)/runtimes/linux-x64/native/libSDL2-2.0.so" Link="libSDL2-2.0.so" ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))" />
  </ItemGroup>
  <Import Project="Publish.props" />
</Project>

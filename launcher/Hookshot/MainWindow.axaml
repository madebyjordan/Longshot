          <Path Fill="#163C2A" Data="F0 M504.724 53.379C519.763 53.379 530.012 67.003 530.012 85.71 530.012 104.314 519.763 117.836 504.724 117.836 489.495 117.836 479.34 104.314 479.34 85.71 479.34 67.003 489.495 53.379 504.724 53.379ZM504.724 111.024C511.812 111.024 515.739 103.604 515.739 85.505 515.739 67.511 511.812 60.089 504.724 60.089 497.541 60.089 493.613 67.511 493.613 85.505 493.613 103.604 497.541 111.024 504.724 111.024ZM498.978 85.913L504.724 76.255 510.376 85.913 504.724 95.165 498.978 85.913Z"/>
          <Path Fill="#163C2A" Data="F0 M552.423 61.309V110.007L559.319 116.312H531.349L538.151 110.007V61.309L531.349 55.006H559.319L552.423 61.309ZM564.875 81.338L577.518 61.309 585.947 55.106H563.917L568.324 60.496 552.327 85.71 566.12 110.924 562.002 116.312H587.194L580.201 110.007 564.875 81.338Z"/>
          <Path Fill="#163C2A" Data="F0 M613.057 78.695C620.433 82.76 627.33 87.64 627.33 99.435 627.33 110.517 618.231 117.836 607.79 117.836 602.138 117.836 598.212 116.312 594.475 113.769L589.591 117.836 589.495 90.792C595.816 105.127 601.085 110.719 607.215 110.719 611.717 110.719 615.932 107.364 615.932 102.077 615.932 96.385 610.567 93.232 604.245 89.675 597.35 85.81 590.261 81.235 590.261 70.458 590.261 59.581 597.924 53.481 608.269 53.481 612.483 53.481 616.507 54.599 619.571 56.836L624.074 53.379V75.441C620.625 64.258 614.783 60.496 609.035 60.496 603.766 60.496 600.797 62.731 600.797 67.003 600.797 72.188 606.737 75.34 613.057 78.695Z"/>
          <Path Fill="#163C2A" Data="F0 M678.033 61.309V110.007L684.834 116.312H658.205L664.911 110.007V88.455H649.393V110.007L656.29 116.312H629.662L636.367 110.007V61.309L629.662 55.006H656.29L649.393 61.309V81.235H664.911V61.309L658.205 55.006H684.834L678.033 61.309Z"/>
          <Path Fill="#163C2A" Data="F0 M711.543 53.379C726.581 53.379 736.831 67.003 736.831 85.71 736.831 104.314 726.581 117.836 711.543 117.836 696.313 117.836 686.16 104.314 686.16 85.71 686.16 67.003 696.313 53.379 711.543 53.379ZM711.543 111.024C718.632 111.024 722.558 103.604 722.558 85.505 722.558 67.511 718.632 60.089 711.543 60.089 704.359 60.089 700.432 67.511 700.432 85.505 700.432 103.604 704.359 111.024 711.543 111.024ZM705.796 85.913L711.543 76.255 717.194 85.913 711.543 95.165 705.796 85.913Z"/>
          <Path Fill="#163C2A" Data="F0 M776.364 61.309H769.276V110.007L776.077 116.312H748.299L754.909 110.007V61.309H747.916L740.349 80.015V55.006H784.027V80.015L776.364 61.309Z"/>
        </Canvas>
      </Viewbox>
      <TextBlock Text="Ocarina of Time Remake Recomp" FontFamily="{StaticResource Glyphic}" FontSize="16" LineHeight="20" Foreground="#163C2A"
                 VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,155,0,0" IsHitTestVisible="False"/>

      <!-- Play, Build while there is no game yet -->
      <Button Name="Go" Classes="card" Width="206" Height="68" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,67"
              IsDefault="True">
        <TextBlock Name="GoText" Text="Play" FontFamily="{StaticResource Glyphic}" FontSize="34" LetterSpacing="-1" Foreground="#000000"/>
      </Button>
      <Button Name="Version" Classes="word" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
              ToolTip.Tip="The releases: bring another version into your game folder"/>
    </Panel>

    <!-- Credits, GitHub and Discord, at the bottom right -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,24">
      <Button Classes="word soft" Content="Credits" VerticalAlignment="Center" Margin="0,0,17,0" Tag="https://github.com/NotRexed/Hookshot#credits"/>
      <Button Classes="mark" Tag="https://github.com/NotRexed/Hookshot" ToolTip.Tip="Hookshot on GitHub">
        <Canvas Width="32" Height="32">
          <Path Fill="#FFFFFF" Data="M8 7.757C7.866 7.757 7.757 7.866 7.757 8 7.757 8.107 7.827 8.198 7.923 8.231 7.935 8.232 7.94 8.225 7.94 8.218 7.94 8.213 7.94 8.194 7.94 8.173 7.879 8.184 7.863 8.159 7.858 8.145 7.855 8.138 7.844 8.117 7.833 8.111 7.825 8.106 7.813 8.095 7.832 8.095 7.852 8.094 7.865 8.112 7.87 8.12 7.892 8.156 7.927 8.146 7.941 8.139 7.943 8.123 7.949 8.113 7.957 8.107 7.902 8.101 7.846 8.08 7.846 7.987 7.846 7.96 7.855 7.939 7.871 7.922 7.868 7.916 7.86 7.891 7.873 7.858 7.873 7.858 7.894 7.851 7.94 7.882 7.96 7.877 7.98 7.875 8.001 7.875 8.022 7.875 8.041 7.877 8.061 7.882 8.107 7.851 8.128 7.858 8.128 7.858 8.141 7.891 8.133 7.916 8.131 7.922 8.146 7.939 8.155 7.96 8.155 7.987 8.155 8.08 8.099 8.101 8.044 8.107 8.054 8.115 8.061 8.129 8.061 8.152 8.061 8.184 8.06 8.211 8.06 8.218 8.06 8.225 8.065 8.232 8.077 8.231 8.173 8.198 8.243 8.107 8.243 8 8.243 7.866 8.134 7.757 8 7.757Z" RenderTransformOrigin="0,0">
            <Path.RenderTransform>
              <TransformGroup><ScaleTransform ScaleX="64" ScaleY="64"/><TranslateTransform X="-496" Y="-496"/></TransformGroup>
            </Path.RenderTransform>
          </Path>
        </Canvas>
      </Button>
      <Button Classes="mark" Margin="10,0,0,0" Tag="https://discord.gg/EajnD2AJD9" ToolTip.Tip="Discord">
        <Canvas Width="32" Height="32">
          <Ellipse Canvas.Left="0.154" Canvas.Top="0.154" Width="31.692" Height="31.692" Fill="#5865F2"/>
          <Path Fill="#FFFFFF" Data="M517.491 506.955a13.067 13.067 0 0 0-3.225-1 0.049 0.049 0 0 0-0.052 0.024 9.102 9.102 0 0 0-0.403 0.826 12.063 12.063 0 0 0-3.622 0 8.349 8.349 0 0 0-0.408-0.826 0.051 0.051 0 0 0-0.052-0.024A13.03 13.03 0 0 0 506.505 506.955a0.046 0.046 0 0 0-0.022 0.019c-2.054 3.069-2.617 6.063-2.341 9.019a0.054 0.054 0 0 0 0.021 0.037 13.141 13.141 0 0 0 3.957 2 0.051 0.051 0 0 0 0.056-0.018 9.392 9.392 0 0 0 0.809-1.317 0.05 0.05 0 0 0-0.027-0.069 8.654 8.654 0 0 1-1.236-0.589 0.051 0.051 0 0 1-0.005-0.084c0.083-0.062 0.166-0.127 0.245-0.192a0.049 0.049 0 0 1 0.051-0.007c2.593 1.184 5.401 1.184 7.964 0a0.049 0.049 0 0 1 0.052 0.006c0.079 0.065 0.162 0.131 0.247 0.193a0.051 0.051 0 0 1-0.004 0.084 8.12 8.12 0 0 1-1.238 0.589 0.05 0.05 0 0 0-0.027 0.07 10.545 10.545 0 0 0 0.809 1.316 0.05 0.05 0 0 0 0.055 0.019 13.097 13.097 0 0 0 3.962-2.001 0.051 0.051 0 0 0 0.021-0.036c0.33-3.418-0.553-6.387-2.343-9.019a0.04 0.04 0 0 0-0.02-0.02zM509.372 514.193c-0.781 0-1.424-0.717-1.424-1.597s0.631-1.597 1.424-1.597c0.799 0 1.437 0.723 1.424 1.597 0.001 0.88-0.63 1.597-1.424 1.597z m5.266 0c-0.781 0-1.424-0.717-1.424-1.597s0.631-1.597 1.424-1.597c0.799 0 1.437 0.723 1.423 1.597 0 0.88-0.624 1.597-1.423 1.597z" RenderTransformOrigin="0,0">
            <Path.RenderTransform><TranslateTransform X="-496" Y="-496"/></Path.RenderTransform>
          </Path>
        </Canvas>
      </Button>
    </StackPanel>

    <!-- ==== Play, Build, Settings: the words at the left. (Releases has no word: the version under Play opens it) ==== -->
    <StackPanel Name="Nav" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,72,0,0" Spacing="12" ZIndex="2">
      <RadioButton Name="NavPlay" Classes="nav" Content="Play" GroupName="Nav" IsChecked="True"/>
      <RadioButton Name="TabBuild" Classes="nav" Content="Build" GroupName="Nav"/>
      <RadioButton Name="TabSettings" Classes="nav" Content="Settings" GroupName="Nav"/>
      <RadioButton Name="TabReleases" GroupName="Nav" IsVisible="False"/>
    </StackPanel>

    <!-- ==== the note at the bottom left: an update out (a Hookshot release, or the launcher's own), one under way, one that stopped ==== -->
    <!-- (a card that grows with what it says, as wide as 225 and up to 300, as tall as its lines: a plain body, and the edges of
         Play's card along its top and bottom, a few pixels high, which stretch only sideways, so nothing of it warps however big
         it is. The edges are as wide as the body: a shape that fills would take all the width it is offered) -->
    <Grid Name="Note" MinWidth="225" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24" IsVisible="False"
          ZIndex="2" RowDefinitions="Auto,Auto,Auto">
      <Path Stretch="Fill" Height="3" Width="{Binding #NoteBody.Bounds.Width}" Fill="{StaticResource NoteFill}" Data="{StaticResource NoteTopEdge}"/>
      <Border Name="NoteBody" Grid.Row="1" Background="{StaticResource NoteFill}" MinHeight="101" Padding="14,10">
      <StackPanel Spacing="7" VerticalAlignment="Center">
        <TextBlock Name="NoteTitle" Classes="ink" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Name="FootWhy" Classes="ink" FontSize="12" LineHeight="16" Foreground="#7A2418" TextAlignment="Center" TextWrapping="Wrap"
                   MaxLines="4" TextTrimming="CharacterEllipsis" IsVisible="False"/>
        <Panel Name="FootBar" Height="20" IsVisible="False">
          <Border Background="#4D37291D" CornerRadius="10"/>
          <Border Name="FootFill" Background="#F7B54E" HorizontalAlignment="Left" Width="0" CornerRadius="10"/>
          <TextBlock Name="FootBarText" Classes="ink" FontSize="12" LineHeight="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Panel>
        <TextBlock Name="FootNote" Classes="ink" FontSize="12" LineHeight="16" TextAlignment="Center" TextWrapping="Wrap" IsVisible="False"/>
        <Button Name="UpdateButton" Classes="pill" Content="Update" IsVisible="False"/>
        <Button Name="FootStopped" Classes="pill" Content="Try again" IsVisible="False"/>
        <Button Name="NoteLink" Classes="inked" Content="see what's new" IsVisible="False"/>
        <Button Name="FootCancel" Classes="inked" Content="Cancel" IsVisible="False"/>
        <StackPanel Name="FootLinks" HorizontalAlignment="Center" Spacing="4" IsVisible="False">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Name="FootDetails" Classes="inked" Content="Show details" FontSize="12"/>
            <Button Name="FootCopy" Classes="inked" Content="Copy error log" FontSize="12"/>
          </StackPanel>
          <Button Name="FootDismiss" Classes="inked" Content="Dismiss" FontSize="12" ToolTip.Tip="Put this away"/>
        </StackPanel>
      </StackPanel>
      </Border>
      <Path Grid.Row="2" Stretch="Fill" Height="4.2" Width="{Binding #NoteBody.Bounds.Width}" Fill="{StaticResource NoteFill}" Data="{StaticResource NoteBottomEdge}"/>
    </Grid>

    <!-- what the hidden programs said: Show details -->
    <TextBox Name="Log" IsVisible="False" Margin="636,72,16,24" IsReadOnly="True" BorderThickness="1" BorderBrush="#303030"
             Background="#E6000000" Foreground="#BCBCBC" FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="11" Padding="10"
             TextWrapping="NoWrap" ZIndex="3"/>

    <!-- the window's name, at the left of its top 48, as the drawing has it -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Height="48" Margin="16,0,0,0" IsHitTestVisible="False"
                Spacing="16" ZIndex="2">
      <Image Source="avares://HookshotLauncher/Assets/hookshot.png" Width="16" Height="16" VerticalAlignment="Center"/>
      <TextBlock Text="Hookshot" FontSize="12" Foreground="#163C2A" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Name="TitleButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="4">
      <Button Name="MinButton" Classes="title" ToolTip.Tip="Minimise"><Path Data="M0,0.5 H10" Width="10" Height="1"/></Button>
      <Button Name="MaxButton" Classes="title" ToolTip.Tip="Maximise"><Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Width="10" Height="10"/></Button>
      <Button Name="CloseButton" Classes="title close" ToolTip.Tip="Close"><Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10"/></Button>
    </StackPanel>

    <!-- ==== Build, Releases and Settings: a panel beside the words, until they are designed for Launcher v3 ==== -->
    <Border Name="Bar" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="340" Margin="280,72,0,24"
            Background="#F0163C2A" CornerRadius="6" ZIndex="1">
      <Grid Margin="0,16,0,12" RowDefinitions="Auto,*">
        <TextBlock Name="BarTitle" Margin="16,0,16,12" FontFamily="{StaticResource Glyphic}" FontSize="22" Foreground="#FFFFFF"/>
          <!-- ==== Build: the game file, the folder, Build Game; the build's options under them ==== -->
          <Grid Name="BuildPage" Grid.Row="1" RowDefinitions="*,Auto">
            <StackPanel>
              <StackPanel Margin="16,0">
                <TextBlock Classes="small" Text="Game File"/>
                <Button Name="SourceChange" Classes="field" Margin="0,8,0,0">
                  <TextBlock Name="SourceText" Classes="small" Foreground="#D6D6D6" Text="Browse files" HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </Button>
              </StackPanel>
              <StackPanel Margin="16,8,16,0">
                <TextBlock Classes="small" Text="Install to"/>
                <Button Name="OutChange" Classes="field" Margin="0,8,0,0">
                  <TextBlock Name="OutText" Classes="small" Foreground="#D6D6D6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Button>
              </StackPanel>
              <Border Margin="0,8,0,0" Padding="16" BorderBrush="#282828" BorderThickness="0,0,0,1">
                <StackPanel>
                  <Panel>
                    <Button Name="BuildGame" Classes="block" Background="#B86C00" Content="Build Game"/>
                    <Panel Name="BuildBar" Height="38" IsVisible="False">
                      <Border Background="#B4692A" CornerRadius="2"/>
                      <Border Name="BuildFill" Background="#D2823F" HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
                      <TextBlock Name="BuildBarText" Classes="line" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                    <Button Name="BuildStopped" Classes="block" Background="#882D23" BorderBrush="#882D23" Content="Build stopped"
                            ToolTip.Tip="Try again" IsVisible="False"/>
                  </Panel>
                  <TextBlock Name="BuildLine" Classes="small" Foreground="#B8B8B8" HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False"/>
                  <TextBlock Name="BuildWhy" Classes="why" Margin="0,8,0,0" MaxHeight="162" TextTrimming="CharacterEllipsis" IsVisible="False"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <!-- (while it builds, or when it stopped: what the programs said, and Cancel or Copy error log) -->
            <StackPanel Name="BuildLinks" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,9" Spacing="8" IsVisible="False">
              <Button Name="BuildDetails" Classes="link" Content="Show details"/>
              <Button Name="BuildCancel" Classes="link" Content="Cancel"/>
              <Button Name="BuildCopy" Classes="link" Content="Copy error log"/>
            </StackPanel>
            <StackPanel Name="BuildOptions" Grid.Row="1">
              <TextBlock Classes="small" Foreground="#B8B8B8" Text="Build options" Margin="16,0"/>
              <Grid Margin="16,8,16,0" Height="32">
                <TextBlock Classes="small" Text="Language" VerticalAlignment="Center"/>
                <ComboBox Name="LanguageBox" Classes="drop"/>
              </Grid>
              <Grid Margin="16,8,16,0" Height="32">
                <TextBlock Classes="small" Text="Workers" VerticalAlignment="Center"/>
                <ComboBox Name="WorkerBox" Classes="drop"/>
              </Grid>
              <Grid Margin="16,8,16,0" Height="32">
                <TextBlock Classes="small" Text="Memory" VerticalAlignment="Center"/>
                <ComboBox Name="MemoryBox" Classes="drop"/>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- ==== Releases: the versions, newest first ==== -->
          <ScrollViewer Name="ReleasesPage" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl Name="ReleaseList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="hb:LaunchChoice">
                    <Button Classes="row" Classes.ticked="{Binding Ticked}" Classes.dim="{Binding Dim}" ToolTip.Tip="{Binding Tip}" Margin="0,0,0,4"
                            Tag="{Binding}">
                      <Grid Height="40" Margin="16,0" ColumnDefinitions="*,24">
                        <TextBlock Classes="line" Text="{Binding Label}" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding $parent[Button].Foreground}"/>
                        <Panel Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                          <Path Classes="mark" Data="{StaticResource TickMark}" IsVisible="{Binding Ticked}" Stroke="{Binding $parent[Button].Foreground}"/>
                          <Path Classes="mark" Data="{StaticResource DownloadMark}" IsVisible="{Binding Arrow}" Stroke="{Binding $parent[Button].Foreground}"/>
                          <Path Classes="mark" Data="{StaticResource RefreshMark}" IsVisible="{Binding Busy}" Stroke="#BBBBBB"/>
                        </Panel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- (the releases after the five newest, in one row until it is pressed) -->
              <Button Name="FoldRow" Classes="row fold" IsVisible="False">
                <Grid Height="40" Margin="16,0" ColumnDefinitions="*,24">
                  <TextBlock Name="FoldText" Classes="line" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}"/>
                  <Panel Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                    <Path Name="FoldMark" Classes="mark" Data="{StaticResource DownMark}" Stroke="{Binding $parent[Button].Foreground}"/>
                  </Panel>
                </Grid>
              </Button>
              <TextBlock Name="ReleasesNote" Classes="small" Foreground="#B0B0B0" Margin="16,8,16,0" TextWrapping="Wrap" IsVisible="False"/>
              <Button Name="OpenFolderLink" Classes="link" Content="Open the game folder" Margin="16,12,16,0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- ==== Settings: what is on or off ==== -->
          <!-- (scrolled, when a note under a switch makes it taller than the panel) -->
          <ScrollViewer Name="SettingsPage" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,0,16,0" Spacing="12">
            <Grid>
              <TextBlock Classes="small" Text="Prepare Shaders" VerticalAlignment="Center"/>
              <ToggleButton Name="PrepareTick" Classes="switch" IsChecked="True"
                            ToolTip.Tip="Prepares the game's shaders at the end of the build, a few minutes (longer on some GPUs). Off, the game prepares them at its first start, behind a black window."/>
            </Grid>
            <Grid>
              <TextBlock Classes="small" Text="Enable DLSS" VerticalAlignment="Center"/>
              <ToggleButton Name="DlssTick" Classes="switch"
                            ToolTip.Tip="For NVIDIA RTX graphics cards. The build downloads NVIDIA's SDK under NVIDIA's license. NVIDIA's files stay on this PC: never share a game folder built with them."/>
            </Grid>
            <Grid>
              <TextBlock Classes="small" Text="Enable FSR 4" VerticalAlignment="Center"/>
              <ToggleButton Name="FsrTick" Classes="switch"
                            ToolTip.Tip="For AMD Radeon graphics cards. The build downloads AMD's runtime under AMD's license (asked when it is switched on). It is chosen in the game's Insert menu, as the Upscaler."/>
            </Grid>
            <!-- (DLSS and FSR 4 take effect at a build: when they no longer say how the game in the folder was built, this says so in a
                 line, the whole under the pointer, and Rebuild builds it again with them) -->
            <Grid Name="RebuildRow" IsVisible="False" Margin="0,-4,0,0">
              <TextBlock Name="RebuildNote" Classes="small" Foreground="#E3B955" VerticalAlignment="Center"/>
              <Button Name="RebuildLink" Classes="link" Content="Rebuild" HorizontalAlignment="Right" VerticalAlignment="Center"
                      ToolTip.Tip="Builds your game again from the game files it keeps, with your settings now. Your saves and settings stay."/>
            </Grid>
            <StackPanel Spacing="4">
              <Grid>
                <TextBlock Classes="small" Text="Lower memory use" VerticalAlignment="Center"/>
                <ToggleButton Name="LowMemTick" Classes="switch"
                              ToolTip.Tip="The game neither loads nor saves its pipeline cache file (mkw_vk_pipelines.bin), which the graphics driver holds in memory for the whole session: up to about 3 GB less memory. On a fresh driver cache the game may stutter more the first time it draws something. The file stays: switched off again, the game uses it as before."/>
              </Grid>
              <TextBlock Name="LowMemNote" Classes="small" Foreground="#B0B0B0" Width="189" HorizontalAlignment="Left" TextWrapping="Wrap" IsVisible="False"/>
            </StackPanel>
            <!-- (#2447's Save my pipeline list: the game folder's list and the "Submit your pipelines" issue's report, zipped into Downloads by
                 the builder's nx2/pipeline_share.py. Only with a game: the list is the game's. What it did, under it) -->
            <StackPanel Spacing="4">
              <Grid>
                <TextBlock Classes="small" Text="Pipeline list" VerticalAlignment="Center"/>
                <Button Name="ShareButton" Classes="link" Content="Save" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip.Tip="Saves the list of pipelines your game made, and a filled-in report, as a zip for the Submit your pipelines issue. Nothing is uploaded."/>
              </Grid>
              <TextBlock Name="ShareNote" Classes="small" Foreground="#B0B0B0" Width="189" HorizontalAlignment="Left" TextWrapping="Wrap"
                         MaxLines="3" TextTrimming="CharacterEllipsis"
                         Text="Helps remove stutter: a zip to attach to the Submit your pipelines issue."/>
            </StackPanel>
            <StackPanel Spacing="4">
              <Grid>
                <TextBlock Classes="small" Text="Enable pre-releases" VerticalAlignment="Center"/>
                <ToggleButton Name="PreTick" Classes="switch"/>
              </Grid>
              <TextBlock Classes="small" Foreground="#B0B0B0" Width="189" HorizontalAlignment="Left" TextWrapping="Wrap">
                <Run Text="These versions contain the latest experimental features and changes, "/><Run Text="bugs may occur." Foreground="#E3B955"/>
              </TextBlock>
            </StackPanel>
            <!-- (the releases are asked for when the window opens; again here) -->
            <Button Name="CheckButton" Classes="block" Content="Check for updates" Margin="0,8,0,12"/>
          </StackPanel>
          </ScrollViewer>
      </Grid>
    </Border>
  </Panel>
</Window>

        <!-- (the mountain and its ring of cloud, drawn 272 to the left of their own frame) -->
        <Canvas Canvas.Left="-272">
          <Path Fill="#FBFBF3" Data="M394 252 A114 15 0 1 0 622 252 A114 15 0 1 0 394 252 Z M410 249 A98 7.5 0 1 1 606 249 A98 7.5 0 1 1 410 249 Z"/>

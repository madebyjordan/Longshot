<!-- The launcher's main screen (Paper: "Hookshot v2", Launcher v3): a landscape behind everything; Play, Build and Settings as words at
     the left; the wordmark and what the game is; Play (Build while there is no game yet) and the version under it, which opens the
     releases; Credits, GitHub and Discord; and a note at the bottom left when an update is out (a Hookshot release, or the
     launcher's own), which also carries an update under way or one that stopped. Build, Settings and the releases open in a panel
     beside the words until they have their own design. Shapes are Paper's own path data -->
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hb="using:HookshotBuilder"
        x:Class="Hookshot.Launcher.MainWindow" Title="Hookshot" Width="960" Height="640" MinWidth="960" MinHeight="640"
        Background="#8CCBEA" WindowStartupLocation="CenterScreen" Icon="avares://HookshotLauncher/Assets/hookshot.png"
        RenderOptions.TextRenderingMode="Antialias">
  <!-- (text smoothed the same way on every system, not by each one's own hinting: the screen is the same picture on Windows and
       Linux) -->
  <Window.Resources>
    <FontFamily x:Key="Glyphic">avares://HookshotLauncher/Assets/Fonts#Faculty Glyphic</FontFamily>
    <!-- Play's torn white card (Paper: "Main Button") -->
    <StreamGeometry x:Key="CardShape">M163.813 67.791L142.538 66.52L110.135 66.52L97.695 66.52L83.74 64.81L39.33 64.81L26.76 63.624L19.703 64.81L0 64.81L0 0.81L38.159 0L60.403 0L74.132 0.81L146.3 0.81L161.912 1.4L171.616 0.81L183.89 0.81L193.957 0.81L206 0.81L206 64.81L178.628 67.791L163.813 67.791Z</StreamGeometry>
    <!-- (the note: its colour, and the edges of Play's card above and below its body, their own 0 at the body's edge) -->
    <SolidColorBrush x:Key="NoteFill" Color="#B89A65"/>
    <StreamGeometry x:Key="NoteTopEdge">M0 0.81L38.159 0L60.403 0L74.132 0.81L146.3 0.81L161.912 1.4L171.616 0.81L206 0.81L206 3L0 3Z</StreamGeometry>
    <StreamGeometry x:Key="NoteBottomEdge">M0 0L206 0L206 1.186L178.628 4.167L163.813 4.167L142.538 2.896L97.695 2.896L83.74 1.186L39.33 1.186L26.76 0L19.703 1.186L0 1.186Z</StreamGeometry>
  </Window.Resources>
  <Window.Styles>
    <!-- Play: the torn white card, a little grey under the pointer and pressed; at 0.4 while it cannot be pressed -->
    <Style Selector="Button.card">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Name="All">
            <Path Name="Card" Stretch="Fill" Fill="#FFFFFF" Data="{StaticResource CardShape}"/>
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.card:pointerover /template/ Path#Card"><Setter Property="Fill" Value="#F1F1EC"/></Style>
    <Style Selector="Button.card:pressed /template/ Path#Card"><Setter Property="Fill" Value="#E2E2DA"/></Style>
    <Style Selector="Button.card:disabled /template/ Panel#All"><Setter Property="Opacity" Value="0.4"/></Style>
    <!-- a word on the screen that does something (the version under Play, Credits): a soft pill, brighter under the pointer -->
    <Style Selector="Button.word">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Box" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,8">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="14" LineHeight="20"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.word:pointerover /template/ Border#Box"><Setter Property="Background" Value="#26FFFFFF"/></Style>
    <Style Selector="Button.word.soft"><Setter Property="Background" Value="#1AFFFFFF"/></Style>
    <Style Selector="Button.mark">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate><ContentPresenter Content="{TemplateBinding Content}"/></ControlTemplate>
      </Setter>
    </Style>
    <!-- Play, Build, Settings at the left: the one shown in white, the others faint, white under the pointer -->
    <Style Selector="RadioButton.nav">
      <Setter Property="Foreground" Value="#A6FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <!-- (35 high as drawn, its word's capitals in the middle: the word itself is taller than that, and overhangs) -->
          <Border Background="Transparent" Padding="4,0" Height="35">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource Glyphic}"
                       FontSize="34" LetterSpacing="-1" VerticalAlignment="Center" Margin="0,-8,0,-8" ClipToBounds="False"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover"><Setter Property="Foreground" Value="#E6FFFFFF"/></Style>
    <Style Selector="RadioButton.nav:checked"><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <!-- the note's button: an amber pill -->
    <Style Selector="Button.pill">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Box" Background="#F7B54E" CornerRadius="13" Padding="12,4">
            <TextBlock Text="{TemplateBinding Content}" Foreground="#000000" FontFamily="{StaticResource Glyphic}" FontSize="14" LineHeight="18"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.pill:pointerover /template/ Border#Box"><Setter Property="Background" Value="#FAC46C"/></Style>
    <Style Selector="Button.pill:pressed /template/ Border#Box"><Setter Property="Background" Value="#E9A43C"/></Style>
    <Style Selector="Button.pill:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
    <!-- a word in the note that does something: underlined, in the note's ink -->
    <Style Selector="Button.inked">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#37291D"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource Glyphic}"
                       FontSize="{TemplateBinding FontSize}" TextDecorations="Underline"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.inked:pointerover"><Setter Property="Foreground" Value="#000000"/></Style>
    <Style Selector="TextBlock.ink"><Setter Property="Foreground" Value="#37291D"/><Setter Property="FontFamily" Value="{StaticResource Glyphic}"/><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="18"/></Style>
    <!-- the window's own buttons at its top right: minimise, maximise, close (red under the pointer) -->
    <Style Selector="Button.title">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Box" Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.title:pointerover /template/ Border#Box"><Setter Property="Background" Value="#1A163C2A"/></Style>
    <Style Selector="Button.title.close:pointerover /template/ Border#Box"><Setter Property="Background" Value="#C42B1C"/></Style>
    <Style Selector="Button.title Path"><Setter Property="Stroke" Value="#163C2A"/><Setter Property="StrokeThickness" Value="1"/></Style>
    <Style Selector="Button.title.close:pointerover Path"><Setter Property="Stroke" Value="#FFFFFF"/></Style>
  </Window.Styles>

  <Panel ClipToBounds="True">
    <!-- ==== the landscape (Paper: Launcher v3's layers, back to front), filling the window as it grows, from the middle ==== -->
    <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
      <Canvas Width="960" Height="640" ClipToBounds="True">
        <Rectangle Width="960" Height="640" Fill="#8CCBEA"/>
        <Path Fill="#A8DAF1" Data="M40 268 C41 266 78 262 97 260 C117 258 148 256 170 256 C192 256 223 257 243 259 C262 261 301 266 300 268 C299 270 256 270 235 271 C214 272 178 272 157 272 C136 272 110 271 92 270 C74 270 39 270 40 268 Z M690 246 C691 244 726 239 745 238 C764 236 794 236 815 236 C836 236 866 236 885 238 C904 239 941 244 940 246 C939 248 898 248 878 249 C857 249 823 250 802 250 C782 250 757 249 740 248 C723 248 689 248 690 246 Z M610 300 C611 299 638 294 652 292 C666 291 689 291 705 292 C721 292 744 293 758 294 C772 295 801 299 800 300 C799 301 768 302 752 302 C737 303 711 303 696 303 C680 303 661 302 648 302 C635 301 609 301 610 300 Z"/>

        </Canvas>
        <Path Fill="#8CD587" Data="M0 436.4C0 436.4 16 437 24 437.1C24.5 437.1 25.1 437.1 25.6 437.1L27.8 433.3L25.7 433.3L28.8 426.6L27.3 426.6L30.2 418.2L33 426.6L31.5 426.6L34.6 433.3L32.6 433.3L34.8 437.3C36 437.3 37.2 437.3 38.4 437.3L40.6 433.3L38.5 433.3L41.7 426.4L40.2 426.4L43.1 417.7L46 426.4L44.5 426.4L47.6 433.3L45.5 433.3L47.8 437.3C47.9 437.3 47.9 437.3 48 437.3C56 437.3 64 437.2 72 437C75.6 436.9 79.2 436.9 82.7 436.8L85.5 431.9L83.1 431.9L86.7 424.1L85 424.1L88.2 414.5L90.6 421.4L91.1 419.7L93.7 427.3L92.3 427.3L93.1 429L95.3 424.2L93.7 424.2L96.9 414.8L100.1 424.2L98.4 424.2L101.8 431.8L99.5 431.8L102 436.2C103.3 436.2 104.7 436.1 106 436.1L107.2 433.8L105.8 433.8L108 429L106.9 429L108.9 423.1L111 429L109.9 429L112.1 433.8L110.6 433.8L111.8 435.9C114.5 435.8 117.3 435.7 120 435.6C128 435.4 136 435.1 144 435C152 434.8 160 434.6 168 434.6C176 434.5 184 434.5 192 434.5C200 434.6 208 434.7 216 434.8C224 435 232 435.2 240 435.4C241.2 435.5 242.3 435.5 243.5 435.5L244.9 433.1L243.3 433.1L245.6 428L244.5 428L246.7 421.5L248.9 428L247.7 428L250.1 433.1L248.5 433.1L250 435.7C254.5 435.9 259 436 263.5 436.1L264.1 435L263 435L264.7 431.5L263.9 431.5L265.4 427L266.9 431.5L266.1 431.5L267.8 435L266.7 435L267.4 436.2C268 436.3 268.7 436.3 269.4 436.3L271.9 431.9L269.6 431.9L273 424.5L271.4 424.5L274.5 415.1L277.7 424.5L276 424.5L279.4 431.9L277.2 431.9L279.8 436.6C281.5 436.6 283.2 436.7 284.9 436.7L286.3 434.3L284.7 434.3L287 429.2L285.9 429.2L288.1 422.9L290.2 429.2L289.1 429.2L291.4 434.3L289.9 434.3L291.3 436.8C298.2 436.9 305.1 437 312 437C320 437.1 328 437 336 436.8C339.1 436.8 342.2 436.7 345.3 436.6L346 435.4L346 435.4L346.1 435.1L345 435.1L346.8 431.1L345.9 431.1L347.6 426.2L348.1 427.9L348.3 427.2L348.9 429L350.2 425.4L351.9 430.6L351 430.6L352.9 434.8L351.7 434.8L352.5 436.4C355 436.3 357.5 436.2 360 436.1C360.8 436.1 361.7 436 362.5 436L366 429.9L363.3 429.9L367.3 421L365.4 421L369.1 409.8L372.9 421L370.9 421L375 429.9L372.3 429.9L375.3 435.3C378.2 43
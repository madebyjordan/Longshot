            <PathGeometry FillRule="EvenOdd" Figures="M278.463 88.3678L268.811 96.7783H300.758L291.106 88.3678V43.4666L331.89 98.8131V85.1587C331.663 84.1369 331.443 83.0983 331.306 82.3266C331.01 80.655 328.987 78.9497 328.014 78.1293C327.702 77.8656 327.497 77.693 327.493 77.6429C327.481 77.4484 327.445 71.5092 330.385 69.0587C332.28 67.4791 331.412 66.4017 330.444 65.1998C329.91 64.5371 329.345 63.8364 329.197 62.9928C328.921 61.4286 329.66 60.1656 330.329 59.0214C330.881 58.076 331.387 57.2118 331.234 56.3256C331.311 54.7116 331.41 51.9399 331.456 50.6233C331.464 50.4 331.471 50.2185 331.475 50.0917C331.479 49.984 331.482 49.9157 331.483 49.8946C331.485 49.8503 331.483 49.5963 331.48 49.2057C331.47 47.8985 331.449 45.0608 331.527 43.4304C331.577 42.403 331.737 40.9249 331.89 39.6512V23.3899L341.678 14.9794H308.779L318.296 23.3899V49.8423L293.145 14.9794H268.811L278.463 23.3899V88.3678Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M415.47 50.7919L405.275 59.2024V98.8131L397.526 95.1505C397.526 95.1505 391.544 98.8131 380.396 98.8131C356.47 98.8131 343.555 82.6704 343.555 55.9467C343.555 27.7308 356.062 12.809 380.396 12.809C389.777 12.809 397.39 17.5568 397.39 17.5568L405.275 12.6733V46.451C400.788 38.0405 392.36 21.7621 380.532 21.7621C368.705 21.7621 363.947 33.157 363.947 55.6754C363.947 79.5503 369.249 89.7243 379.309 89.7243C384.203 89.7243 387.058 87.1469 387.058 87.1469V59.0667L377.27 50.7919H415.47Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M450.892 46.5866C461.36 52.0127 471.148 58.5241 471.148 74.2599C471.148 89.0461 458.233 98.8131 443.415 98.8131C435.394 98.8131 429.82 96.7783 424.518 93.387L417.585 98.8131L417.449 62.7293C426.422 81.8564 433.899 89.3174 442.599 89.3174C448.989 89.3174 454.97 84.8408 454.97 77.7868C454.97 70.1903 447.357 65.985 438.385 61.2372C428.597 56.0823 418.537 49.978 418.537 35.5987C418.537 21.0838 429.412 12.9446 444.095 12.9446C450.076 12.9446 455.786 14.4368 460.136 17.4212L466.526 12.809V42.2457C461.632 27.3239 453.339 22.3047 445.182 22.3047C437.705 22.3047 433.491 25.2891 433.491 30.9865C433.491 37.9048 441.919 42.1101 450.892 46.5866Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M543.109 23.3899V88.3678L552.761 96.7783H514.968L524.484 88.3678V59.6093H502.461V88.3678L512.249 96.7783H474.456L483.972 88.3678V23.3899L474.456 14.9794H512.249L502.461 23.3899V49.978H524.484V23.3899L514.968 14.9794H552.761L543.109 23.3899Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M600.584 20.4152C603.671 21.4761 610.504 23.8241 616.782 25.219C622.985 32.8704 626.559 43.5754 626.559 55.9467C626.559 80.7712 612.012 98.8131 590.669 98.8131C569.053 98.8131 554.643 80.7712 554.643 55.9467C554.643 36.9343 563.004 21.8573 576.541 15.7514C582.78 15.8794 586.826 15.3288 589.966 14.9015C590.821 14.7851 591.609 14.6779 592.356 14.596C596.377 17.0447 598.19 18.911 598.927 19.6701C599.045 19.7912 599.135 19.884 599.202 19.9467C599.484 20.0371 599.957 20.1997 600.584 20.4152ZM590.669 89.7243C600.729 89.7243 606.303 79.8216 606.303 55.6754C606.303 31.6648 600.729 21.7621 590.669 21.7621C580.473 21.7621 574.899 31.6648 574.899 55.6754C574.899 79.8216 580.473 89.7243 590.669 89.7243ZM582.512 56.218L590.669 43.3309L598.69 56.218L590.669 68.5624L582.512 56.218Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M632.713 17.4516C632.325 17.443 631.94 17.3675 631.553 17.2372V48.3501L642.292 23.3899H652.216V88.3678L642.836 96.7783H682.26L672.608 88.3678V23.3899H682.668L693.544 48.3501V14.9794H677.195C676.47 15.4871 675.8 16.0015 675.17 16.4854C673.326 17.9023 671.82 19.0587 670.255 19.024C668.65 18.9884 667.035 18.5229 665.056 17.9525C661.926 17.0504 657.886 15.8861 651.539 15.7452C645.223 15.605 641.129 16.3112 637.956 16.8585C635.949 17.2046 634.311 17.4871 632.713 17.4516Z"/>
          </GeometryGroup>
          <!-- the launcher's text: Segoe UI, 16 in a line of 20 -->
          <Style x:Key="Line" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
          </Style>
          <!-- (the keyboard's place: a line around the button it is on) -->
          <Style x:Key="Ring" TargetType="Control">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate>
                  <Rectangle Stroke="#EBB07E" StrokeThickness="1.5" RadiusX="8" RadiusY="8" Margin="-4"/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a round-ended button: All Versions (black), Check for updates (leather), the version under Play (no fill) -->
          <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Border Background="{TemplateBinding Background}" CornerRadius="18"/>
                    <Border x:Name="Shine" Background="#FFFFFF" CornerRadius="18" Opacity="0"/>
                    <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
                      <!-- (a dot before the word when the button's Tag is "news": All Versions, when a newer release is out) -->
                      <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#EBB07E" Margin="-4,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                      <TextBlock Style="{StaticResource Line}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="news">
                      <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.04"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a round-ended button with a mark before its word: Menu, Close menu -->
          <Style x:Key="MarkPill" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Border Background="{TemplateBinding Background}" CornerRadius="20"/>
                    <Border x:Name="Shine" Background="#FFFFFF" CornerRadius="20" Opacity="0"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.04"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a choice the build asks for (Paper: "v3 - Build: first time"): a round-ended black row with what it is, what is
               chosen, and at its right the word that changes it -->
          <Style x:Key="ChoicePill" TargetType="Border">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="416"/>
            <Setter Property="Padding" Value="24,0,8,0"/>
          </Style>
          <Style x:Key="Word" TargetType="Button">
            <Setter Property="Foreground" Value="#EBB07E"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent">
                    <TextBlock Style="{StaticResource Line}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                               Margin="{TemplateBinding Padding}"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <!-- (the folder in its row: typed into, with no box of its own) -->
          <Style x:Key="PillText" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#815E40"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- the small line (13 in 18): under the choices, and what a stopped build says -->
          <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="#BCBCBC"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
          </Style>
          <!-- (a word in such a line that does something: in the accent, no line under it) -->
          <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#EBB07E"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <!-- a build option that is on or off, in the menu (Paper: "v3 - Build options"): a row like a version's, in the accent
               with the mark at its right while it is on -->
          <Style x:Key="MenuTick" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#BCBCBC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                  <Grid Height="40" Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Line}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Canvas x:Name="Mark" Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" Visibility="Hidden">
                      <Path Data="M4.5,12.75 l6,6 l9,-13.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Stroke="{TemplateBinding Foreground}"/>
                    </Canvas>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                      <Setter Property="Foreground" Value="#EBB07E"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a build option picked from a list, in the menu: a row with what is picked (its Tag before it, "Workers: ") and an
               arrow, and the list under it -->
          <Style x:Key="MenuChoiceItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#BCBCBC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Box" Background="Transparent" CornerRadius="16" Padding="14,6">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Foreground" Value="#EBB07E"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#1AFFFFFF"/>
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="MenuChoice" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="#BCBCBC"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuChoiceItem}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                  <Grid>
                    <ToggleButton Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <Grid IsHitTestVisible="False">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Line}" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/><Run
                             Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                      </TextBlock>
                      <Canvas Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                        <Path Data="M19.5,8.25 l-7.5,7.5 l-7.5,-7.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{TemplateBinding Foreground}"/>
                      </Canvas>
                    </Grid>
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                      <Border Background="#0A0A0A" BorderBrush="#303030" BorderThickness="1" CornerRadius="16" Padding="4" Margin="0,2,0,0"
                              MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                        <ScrollViewer Style="{DynamicResource SlimScroll}" VerticalScrollBarVisibility="Auto">
                          <ItemsPresenter/>
                        </ScrollViewer>
                      </Border>
                    </Popup>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- the list a row opens beside itself: the game files found (Launcher.cs fills it) -->
          <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                  <Border Background="#0A0A0A" BorderBrush="#303030" BorderThickness="1" CornerRadius="16" Padding="4" MinWidth="240" MaxWidth="520">
                    <StackPanel IsItemsHost="True"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#BCBCBC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                  <Border x:Name="Box" Background="Transparent" CornerRadius="16" Padding="14,7">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter Property="Foreground" Value="#EBB07E"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#1AFFFFFF"/>
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- Play: a torn strip of leather, as drawn (257 x 98) -->
          <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="All">
                    <Path x:Name="Strip" Stretch="Fill" Fill="{StaticResource Leather}" Data="{StaticResource StripShape}"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Strip" Property="Fill" Value="#8F6A49"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Strip" Property="Fill" Value="#755439"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="All" Property="Opacity" Value="0.4"/>
                      <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a version in the bar: its name (cut short when it is longer than the bar, which stays 240 wide and clear of the wordmark)
               and a mark in a place of 24 at the right (picked, or not on this PC yet) -->
          <Style x:Key="Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <!-- (its text and its mark read the button's Foreground: white under the pointer) -->
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <Style x:Key="FoldInk" TargetType="Button" BasedOn="{StaticResource Row}">
            <Setter Property="Foreground" Value="#8E8E8E"/>
          </Style>
          <Style x:Key="RowInk" TargetType="Button" BasedOn="{StaticResource Row}">
            <Setter Property="Foreground" Value="#BCBCBC"/>
          </Style>
          <!-- (its ink: the version picked in the accent, one nothing can bring dim. LaunchList.cs) -->
          <Style x:Key="VersionInk" TargetType="Button" BasedOn="{StaticResource Row}">
            <Setter Property="Foreground" Value="#BCBCBC"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Dim, Mode=OneTime}" Value="True">
                <Setter Property="Foreground" Value="#747474"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Picked, Mode=OneTime}" Value="True">
                <Setter Property="Foreground" Value="#EBB07E"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
          <DataTemplate x:Key="VersionRow">
            <Button Style="{StaticResource VersionInk}" ToolTip="{Binding Tip, Mode=OneTime}" Click="LauncherRowClick"
                    AutomationProperties.Name="{Binding Label, Mode=OneTime}">
              <Grid Height="40">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Line}" Text="{Binding Label, Mode=OneTime}" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <Canvas Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                  <Path Data="M4.5,12.75 l6,6 l9,-13.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Visibility="{Binding Ticked, Mode=OneTime, Converter={StaticResource Shown}}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Path Data="M3,16.5 v2.25 A2.25,2.25 0 0 0 5.25,21 h13.5 A2.25,2.25 0 0 0 21,18.75 V16.5 M16.5,12 L12,16.5 L7.5,12 M12,16.5 V3"
                        StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Visibility="{Binding Arrow, Mode=OneTime, Converter={StaticResource Shown}}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Canvas>
              </Grid>
            </Button>
          </DataTemplate>
          <!-- the bar's own scroll bar: a thin thumb at its right edge, shown while the pointer is over the bar -->
          <Style x:Key="SlimBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border CornerRadius="3" Background="#59FFFFFF"/>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="SlimScroll" TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                  <Grid Background="Transparent">
                    <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SlimBar}" HorizontalAlignment="Right" Margin="0,4,5,8" Opacity="0"
                               Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                               Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- the window's buttons, as Windows 11 draws its own: 48 x 48, the close button red under the pointer -->
          <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="Transparent">
                    <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#E6FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a mark that opens a page (GitHub, Discord) -->
          <Style x:Key="MarkButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Opacity" Value="0.8"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Grid.Resources>

        <!-- the picture of the game, dim behind everything (it covers the window, cut evenly at the sides) -->
        <Image Source="pack://application:,,,/Images/launcher.jpg" Stretch="UniformToFill" Opacity="0.12" HorizontalAlignment="Center"
               VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- the wordmark (its glow: the same letters blurred over them, as the drawing's own) and what the game is -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,99,0,0" IsHitTestVisible="False">
          <Viewbox Width="416">
            <Canvas Width="561.741" Height="86.14">
              <Path Data="{StaticResource Wordmark}" Fill="#C09E52">
                <Path.RenderTransform><TranslateTransform X="-131.803" Y="-12.673"/></Path.RenderTransform>
              </Path>
            </Canvas>
          </Viewbox>
          <Viewbox Width="416">
            <Viewbox.Effect><BlurEffect Radius="19" KernelType="Gaussian"/></Viewbox.Effect>
            <Canvas Width="561.741" Height="86.14">
              <Path Data="{StaticResource Wordmark}" Fill="#C09E52">
                <Path.RenderTransform><TranslateTransform X="-131.803" Y="-12.673"/></Path.RenderTransform>
              </Path>
            </Canvas>
          </Viewbox>
        </Grid>
        <TextBlock Style="{StaticResource Line}" Text="Ocarina of Time Remake Recomp" Foreground="#CFCFCF" VerticalAlignment="Top"
                   HorizontalAlignment="Center" Margin="0,181,0,0" IsHitTestVisible="False"/>

        <!-- the button that plays the version picked, the version under it (pressed: its folder) and a line when there is one to say -->
        <Button x:Name="LauncherGo" Style="{StaticResource PlayButton}" Width="257" Height="98" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,91" IsDefault="True" Click="LauncherGoClick" AutomationProperties.Name="{Binding Text, ElementName=LauncherGoText}">
          <TextBlock x:Name="LauncherGoText" Text="Play" FontFamily="{DynamicResource Serif}" FontSize="44" Foreground="#37291D">
            <TextBlock.RenderTransform><TranslateTransform x:Name="LauncherGoNudge"/></TextBlock.RenderTransform>
          </TextBlock>
        </Button>
        <Grid x:Name="LauncherProgress" Width="257" Height="98" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,91"
              Visibility="Collapsed" IsHitTestVisible="False">
          <Path Stretch="Fill" Fill="{StaticResource Leather}" Opacity="0.35" Data="{StaticResource StripShape}"/>
          <Path Stretch="Fill" Fill="{StaticResource Leather}" Data="{StaticResource StripShape}">
            <Path.Clip><RectangleGeometry x:Name="ProgressClip" Rect="0,0,0,98"/></Path.Clip>
          </Path>
        </Grid>
        <Button x:Name="LauncherVersion" Style="{StaticResource Pill}" Background="Transparent" Padding="42,8" VerticalAlignment="Bottom"
                HorizontalAlignment="Center" Margin="0,0,0,38" ToolTip="Open the game folder" Click="LauncherFolderClick"/>
        <TextBlock x:Name="LauncherStatus" FontFamily="Segoe UI" FontSize="13" Foreground="#BCBCBC" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,0,0,19" LineHeight="18"
                   LineStackingStrategy="BlockLineHeight" IsHitTestVisible="False" Background="Transparent" MouseLeftButtonUp="StatusClick"/>

        <!-- what a build from game files asks for, between the wordmark and the button (Paper: "v3 - Build: first time"): the
             game files (the word at the right lists the ones found, and the ways to choose others) and where the game goes.
             The build's other options are in the menu -->
        <StackPanel x:Name="FilesBlock" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,268,0,0" Visibility="Collapsed">
          <Border Style="{StaticResource ChoicePill}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Line}" Text="Game files" Foreground="#8E8E8E" VerticalAlignment="Center"/>
              <TextBlock x:Name="SourceText" Grid.Column="1" Style="{StaticResource Line}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Button x:Name="SourceChange" Grid.Column="2" Style="{StaticResource Word}" Content="Change" Click="SourceChangeClick"
                      AutomationProperties.Name="Change the game files"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource ChoicePill}" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Line}" Text="Install to" Foreground="#8E8E8E" VerticalAlignment="Center"/>
              <TextBox x:Name="OutPath" Grid.Column="1" Style="{StaticResource PillText}" TextChanged="PathsChanged"
                       AutomationProperties.Name="The folder the game is installed to"/>
              <Button x:Name="ChangeButton" Grid.Column="2" Style="{StaticResource Word}" Content="Change" Click="BrowseOut"
                      AutomationProperties.Name="Change where the game is installed"/>
            </Grid>
          </Border>
          <!-- (one line under them: another way in, what the button will do, or why the file chosen cannot be used) -->
          <TextBlock x:Name="FilesNote" Style="{StaticResource Small}" MaxWidth="480" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- right after a build, over the launcher it has become (Paper: "v3 - Game ready"): the shortcuts, each made or taken
             away by the word at its right, and what the build keeps on this PC -->
        <StackPanel x:Name="ReadyBlock" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,268,0,0" Visibility="Collapsed">
          <Border Style="{StaticResource ChoicePill}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Line}" Text="Desktop" Foreground="#8E8E8E" VerticalAlignment="Center"/>
              <TextBlock x:Name="DesktopText" Grid.Column="1" Style="{StaticResource Line}" VerticalAlignment="Center"/>
              <Button x:Name="DesktopWord" Grid.Column="2" Style="{StaticResource Word}" Click="DesktopShortcutClick"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource ChoicePill}" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Line}" Text="Start menu" Foreground="#8E8E8E" VerticalAlignment="Center"/>
              <TextBlock x:Name="StartText" Grid.Column="1" Style="{StaticResource Line}" VerticalAlignment="Center"/>
              <Button x:Name="StartWord" Grid.Column="2" Style="{StaticResource Word}" Click="StartShortcutClick"/>
            </Grid>
          </Border>
          <TextBlock x:Name="StorageNote" Style="{StaticResource Small}" MaxWidth="480" Margin="0,14,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- when a build stopped and one line under the button does not hold why: the reason whole, and what to do about it -->
        <StackPanel x:Name="ProblemBlock" MaxWidth="480" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,232,0,0" Visibility="Collapsed">
          <TextBlock x:Name="ProblemHead" Style="{StaticResource Line}" TextAlignment="Center" TextWrapping="Wrap"/>
          <ScrollViewer Style="{StaticResource SlimScroll}" MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock x:Name="ProblemText" Style="{StaticResource Small}"/>
              <StackPanel x:Name="ProblemSteps" Margin="0,6,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>

        <!-- what the hidden programs said, over the picture: Show details, in the menu's steps and when a build stopped -->
        <TextBox x:Name="Log" Visibility="Collapsed" Margin="240,216,24,204" IsReadOnly="True" BorderThickness="1" BorderBrush="#303030"
                 Background="#E0000000" Foreground="#BCBCBC" FontFamily="{StaticResource Mono}" FontSize="11" Padding="10"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

        <!-- the menu's button, at the top left while the menu is closed (Paper: "Master"); its dot says a newer release is in there -->
        <Button x:Name="MenuButton" Style="{StaticResource MarkPill}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,72,0,0"
                Click="MenuClick" AutomationProperties.Name="Menu">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="20" Height="20" VerticalAlignment="Center">
              <Path Data="M3.125,5.625 h13.75 M3.125,10 h13.75 M3.125,14.375 h13.75" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <TextBlock Style="{StaticResource Line}" Text="Menu" Margin="8,0,0,0"/>
            <Ellipse x:Name="MenuDot" Width="8" Height="8" Fill="#EBB07E" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
        </Button>

        <!-- at the bottom left, what acts on the moment: Cancel while a version is brought or the game is built; Back and Copy
             details when that stopped (Paper: "v2 - Updating", "v2 - Update stopped"; the line that says why, pressed, shows
             what the programs said); Back from the build's choices to the launcher they were opened from -->
        <Button x:Name="LauncherCancel" Style="{StaticResource Pill}" Content="Cancel" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="16,0,0,38" Visibility="Collapsed" Panel.ZIndex="1" Click="LauncherCancelClick"/>
        <StackPanel x:Name="LauncherStopped" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,38"
                    Visibility="Collapsed" Panel.ZIndex="1">
          <Button x:Name="StoppedBack" Style="{StaticResource Pill}" Content="Back" Click="StoppedBackClick"/>
          <Button x:Name="LauncherCopy" Style="{StaticResource Pill}" Content="Copy details" Margin="8,0,0,0" Click="StoppedCopyClick"/>
        </StackPanel>
        <Button x:Name="FilesBack" Style="{StaticResource Pill}" Content="Back" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="16,0,0,38" Visibility="Collapsed" Panel.ZIndex="1" Click="BackToLauncherClick"/>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,40">
          <Button Style="{StaticResource MarkButton}" ToolTip="Longshot on GitHub" AutomationProperties.Name="Longshot on GitHub" Tag="https://github.com/madebyjordan/longshot" Click="LauncherLinkClick">
            <Canvas Width="32" Height="32">
              <Path Fill="#FFFFFF" Data="M8 7.757C7.866 7.757 7.757 7.866 7.757 8 7.757 8.107 7.827 8.198 7.923 8.231 7.935 8.232 7.94 8.225 7.94 8.218
                    7.94 8.213 7.94 8.194 7.94 8.173 7.879 8.184 7.863 8.159 7.858 8.145 7.855 8.138 7.844 8.117 7.833 8.111 7.825 8.106 7.813 8.095
                    7.832 8.095 7.852 8.094 7.865 8.112 7.87 8.12 7.892 8.156 7.927 8.146 7.941 8.139 7.943 8.123 7.949 8.113 7.957 8.107 7.902 8.101
                    7.846 8.08 7.846 7.987 7.846 7.96 7.855 7.939 7.871 7.922 7.868 7.916 7.86 7.891 7.873 7.858 7.873 7.858 7.894 7.851 7.94 7.882
                    7.96 7.877 7.98 7.875 8.001 7.875 8.022 7.875 8.041 7.877 8.061 7.882 8.107 7.851 8.128 7.858 8.128 7.858 8.141 7.891 8.133 7.916
                    8.131 7.922 8.146 7.939 8.155 7.96 8.155 7.987 8.155 8.08 8.099 8.101 8.044 8.107 8.054 8.115 8.061 8.129 8.061 8.152 8.061 8.184
                    8.06 8.211 8.06 8.218 8.06 8.225 8.065 8.232 8.077 8.231 8.173 8.198 8.243 8.107 8.243 8 8.243 7.866 8.134 7.757 8 7.757Z">
                <Path.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleX="64" ScaleY="64"/>
                    <TranslateTransform X="-496" Y="-496"/>
                  </TransformGroup>
                </Path.RenderTransform>
              </Path>
            </Canvas>
          </Button>
          <!-- (the server Longshot's CONTRIBUTING.md names) -->
          <Button Style="{StaticResource MarkButton}" Margin="10,0,0,0" ToolTip="Discord" AutomationProperties.Name="Discord" Tag="https://discord.gg/EajnD2AJD9" Click="LauncherLinkClick">
            <Canvas Width="32" Height="32">
              <Ellipse Canvas.Left="0.154" Canvas.Top="0.154" Width="31.692" Height="31.692" Fill="#5865F2"/>
              <Path Fill="#FFFFFF" Data="M517.491 506.955a13.067 13.067 0 0 0-3.225-1 0.049 0.049 0 0 0-0.052 0.024 9.102 9.102 0 0 0-0.403 0.826
                    12.063 12.063 0 0 0-3.622 0 8.349 8.349 0 0 0-0.408-0.826 0.051 0.051 0 0 0-0.052-0.024A13.03 13.03 0 0 0 506.505 506.955a0.046 0.046
                    0 0 0-0.022 0.019c-2.054 3.069-2.617 6.063-2.341 9.019a0.054 0.054 0 0 0 0.021 0.037 13.141 13.141 0 0 0 3.957 2 0.051 0.051 0 0 0
                    0.056-0.018 9.392 9.392 0 0 0 0.809-1.317 0.05 0.05 0 0 0-0.027-0.069 8.654 8.654 0 0 1-1.236-0.589 0.051 0.051 0 0 1-0.005-0.084c0.083-0.062
                    0.166-0.127 0.245-0.192a0.049 0.049 0 0 1 0.051-0.007c2.593 1.184 5.401 1.184 7.964 0a0.049 0.049 0 0 1 0.052 0.006c0.079 0.065 0.162
                    0.131 0.247 0.193a0.051 0.051 0 0 1-0.004 0.084 8.12 8.12 0 0 1-1.238 0.589 0.05 0.05 0 0 0-0.027 0.07 10.545 10.545 0 0 0 0.809

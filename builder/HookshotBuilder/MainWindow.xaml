<Window x:Class="HookshotBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Longshot" Width="960" Height="640" MinWidth="960" MinHeight="640" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#121212" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource Ui}">

  <!-- One window, 960x640, and it can be maximised: the launcher, and the build in the same window (Launcher.cs) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="18" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" Background="#121212">

    <!-- ===================== the one screen, as drawn in Paper (the file Longshot: "Master", "Master Menu", and the "v2" and
         "v3" artboards, 960 x 640) =====================
         The wordmark over a dim picture of the game and one button in the same place throughout: it plays the version picked
         (or updates or builds the folder to it first), builds the game from the player's game files the first time, and is
         the strip that fills while either is done. The menu, a bar from the left, holds what goes with the moment: the
         versions, a build's options, a build's steps (Launcher.cs; the build itself is MainWindow.xaml.cs) -->
    <Border x:Name="LauncherScreen" Background="#121212" MouseLeftButtonDown="LauncherBackClick">
      <Grid ClipToBounds="True">
        <Grid.Resources>
          <FontFamily x:Key="Serif">pack://application:,,,/Fonts/#Marcellus</FontFamily>
          <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
          <SolidColorBrush x:Key="Leather" Color="#815E40"/>
          <BooleanToVisibilityConverter x:Key="Shown"/>

          </GeometryGroup>
          <Style x:Key="VersionItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#ECE7DC"/>
            <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Box" Background="Transparent" Padding="16,10">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#1D1C19"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#24211A"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="VersionPick" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource Serif}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#F2EEE6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VersionItem}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                  <Grid>
                    <ToggleButton Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="Box" Background="#080808" BorderBrush="#34312C" BorderThickness="1">
                            <Path Data="M0,0 L6,6 L12,0" Stroke="#D9D4CA" StrokeThickness="1.4" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Box" Property="BorderBrush" Value="#5A5246"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Box" Property="BorderBrush" Value="#8C7442"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding ItemTemplate}" VerticalAlignment="Center" Margin="22,0,44,1"/>
                    <!-- (opens upward: the list is at the window's foot) -->
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Top" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                      <Border Background="#0D0D0C" BorderBrush="#34312C" BorderThickness="1" Margin="0,0,0,4"
                              MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsPresenter/>
                        </ScrollViewer>
                      </Border>
                    </Popup>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="#C4A052">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#D3B062"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#B08F47"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Box" Property="Background" Value="#4D4433"/>
                      <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="QuietLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <TextBlock x:Name="Text" Text="{TemplateBinding Content}" FontFamily="{DynamicResource Serif}" FontSize="12" Foreground="#6A645A"/>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Text" Property="Foreground" Value="#B9AE98"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Grid.Resources>

        <!-- the frame and its corners -->
        <Border Margin="9" CornerRadius="11" BorderBrush="#352F27" BorderThickness="1.5" IsHitTestVisible="False"/>
        <Path Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,40,0,0"/>
        <Path Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,30,0">
          <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
        </Path>
        <Path Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,32">
          <Path.RenderTransform><ScaleTransform ScaleY="-1"/></Path.RenderTransform>
        </Path>
        <Path Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,32">
          <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Path.RenderTransform>
        </Path>

        <!-- the wordmark -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0" IsHitTestVisible="False">
          <!-- (the glow: the same outlines blurred behind them, as the drawing's own) -->
          <Viewbox Width="500" HorizontalAlignment="Center">
            <Grid Width="826" Height="112">
              <Path Data="{StaticResource Wordmark}" Fill="#C09E52">
                <Path.Effect><BlurEffect Radius="19" KernelType="Gaussian"/></Path.Effect>
              </Path>
              <Path Data="{StaticResource Wordmark}" Fill="#C09E52"/>
            </Grid>
          </Viewbox>
          <TextBlock Text="Ocarina of Time Recomp" FontFamily="{DynamicResource Serif}" FontSize="19" Foreground="#ECE7DC"
                     HorizontalAlignment="Center" Margin="0,22,0,0"/>
        </StackPanel>

        <!-- the version, and the button that plays it -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,38">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox x:Name="LauncherVersions" Style="{StaticResource VersionPick}" Width="270" Height="50" VerticalAlignment="Center"
                      SelectionChanged="LauncherVersionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontFamily="{DynamicResource Serif}">
                    <Run Text="{Binding Label, Mode=OneWay}"/>
                    <Run Text="{Binding Badge, Mode=OneWay}" Foreground="{Binding BadgeBrush, Mode=OneWay}"/>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="LauncherGo" Style="{StaticResource GoldButton}" Width="220" Height="76" Margin="40,0,0,0" Click="LauncherGoClick">
              <TextBlock x:Name="LauncherGoText" Text="Play" FontFamily="{DynamicResource Serif}" FontSize="32" Foreground="#16140F" Margin="0,0,0,3"/>
            </Button>
          </StackPanel>
          <TextBlock x:Name="LauncherStatus" FontFamily="{DynamicResource Serif}" FontSize="13" Foreground="#8F887B" HorizontalAlignment="Center"
                     TextAlignment="Center" Margin="0,16,0,0" MinHeight="18"/>
          <Button x:Name="LauncherFolder" Style="{StaticResource QuietLink}"
                  HorizontalAlignment="Center" Margin="0,6,0,0" Content="Open the game folder" Click="LauncherFolderClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- the window's own buttons, over everything -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Panel.ZIndex="9"
                WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource Caption}" Click="Minimize" ToolTip="Minimize">
        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button Style="{StaticResource Caption}" Click="CloseWindow" ToolTip="Close">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>

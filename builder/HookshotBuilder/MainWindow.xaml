                    1.597-1.423 1.597z">
                <Path.RenderTransform><TranslateTransform X="-496" Y="-496"/></Path.RenderTransform>
              </Path>
            </Canvas>
          </Button>
        </StackPanel>

        <!-- All Versions: what is on this PC and what is not, picked by a press. Anywhere else in the window closes it -->
        <Border x:Name="VersionBar" Visibility="Collapsed" HorizontalAlignment="Left" Width="240" Background="#B0000000"
                BorderBrush="#303030" BorderThickness="0,0,1,0" MouseLeftButtonDown="LauncherBarClick">
          <Border.RenderTransform><TranslateTransform x:Name="VersionBarSlide"/></Border.RenderTransform>
          <ScrollViewer Style="{StaticResource SlimScroll}" Margin="0,48,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,64">
              <TextBlock Style="{StaticResource Line}" Text="All Versions"/>
              <Button x:Name="LauncherCheck" Style="{StaticResource Pill}" Background="{StaticResource Leather}" Content="Check for updates"
                      MinWidth="176" HorizontalAlignment="Left" Margin="0,12,0,0" Click="LauncherCheckClick"/>
              <StackPanel x:Name="NewVersions" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Line}" Text="Update available"/>
                <ItemsControl x:Name="NewList" ItemTemplate="{StaticResource VersionRow}" Margin="0,12,0,0" Focusable="False"/>
              </StackPanel>
              <StackPanel x:Name="HereVersions" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Line}" Text="Installed"/>
                <ItemsControl x:Name="HereList" ItemTemplate="{StaticResource VersionRow}" Margin="0,12,0,-4" Focusable="False">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,4"/></Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
              </StackPanel>
              <StackPanel x:Name="OtherVersions" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock x:Name="OtherTitle" Style="{StaticResource Line}" Text="Older versions"/>
                <ItemsControl x:Name="OtherList" ItemTemplate="{StaticResource VersionRow}" Margin="0,12,0,-12" Focusable="False">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,12"/></Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- the window's name, at the left of its top 48, over the bar of versions as the drawing has it -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Height="48" Margin="16,0,0,0" IsHitTestVisible="False">
          <Image Source="pack://application:,,,/Images/longshot.png" Width="16" Height="16" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Longshot" FontFamily="Segoe UI" FontSize="12" Foreground="#E6FFFFFF" Margin="16,0,0,2" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- the launcher's own window buttons (it can be maximised: everything in it holds to an edge or the middle) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize"/>
          <Button x:Name="LauncherMax" Style="{StaticResource TitleButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="LauncherMaxClick"/>
          <Button Style="{StaticResource TitleButton}" Background="#C42B1C" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="CloseWindow"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- the installer's window buttons, over its pages (the launcher has its own) -->
    <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Panel.ZIndex="9"
                WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource Caption}" Click="Minimize" ToolTip="Minimize">
        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button Style="{StaticResource Caption}" Click="CloseWindow" ToolTip="Close">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>

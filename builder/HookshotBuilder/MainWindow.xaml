<Window x:Class="HookshotBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hookshot" Width="960" Height="640" MinWidth="960" MinHeight="640" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#121212" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource Ui}">

  <!-- One window, 960x640, and it can be maximised: the launcher, and the build in the same window (Launcher.cs) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="18" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" Background="#121212">

    <!-- ===================== the one screen, as drawn in Paper (the file "Hookshot v2", 960 x 640) =====================
         The wordmark over a dim picture of the game, Play under it with the version it plays, and the menu: a panel from the
         left with three tabs. Build: the game files, the folder, Build Game (the bar that fills while it builds) and the
         build's options. Releases: the versions, the one in the folder ticked, another brought by a press. Settings: what is on
         or off. At its foot, Check for updates (or Update Available, or the bar of an update under way). Launcher.cs is the
         launcher's part; the build itself is MainWindow.xaml.cs -->
    <Border x:Name="LauncherScreen" Background="#121212" MouseLeftButtonDown="LauncherBackClick">
      <Grid ClipToBounds="True">
        <Grid.Resources>
          <FontFamily x:Key="Serif">pack://application:,,,/Fonts/#Marcellus</FontFamily>
          <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
          <BooleanToVisibilityConverter x:Key="Shown"/>
          <!-- Play's outline, as drawn: a torn strip (257 x 98) -->
          <Geometry x:Key="StripShape">M442.631 118.999C448.417 120.005 452.962 121.032 453.489 121.045 454.487 121.07 475.335 122.287 486.302 122.555 492.957 122.718 503.52 122.793 511 122.832 511 122.832 511 209.654 511 209.654 507.192 209.846 503.557 210.032 500.7 210.184 489.689 210.771 468.701 212.289 467.693 212.334 466.816 212.373 448.015 213.053 438.322 213.404 428.277 213.767 422.536 210.245 407.737 214.229 393.317 218.111 390.477 212.062 381.226 212.077 379.3 211.44 377.766 210.981 374.519 210.872 371.312 210.795 368.683 210.668 366.926 210.58 366.565 210.561 366.344 210.703 366.319 210.868 366.299 211 366.404 211.146 366.666 211.24 367.285 211.46 368.092 211.706 369.122 211.973 369.942 212.176 370.856 212.491 371.844 212.858 361.446 214.11 348.69 216.408 348.008 216.433 347.223 216.461 332.4 217.028 322.124 217.407 322.124 217.407 254 217.407 254 217.407 254 217.407 254 118.999 254 118.999 254 118.999 442.631 118.999 442.631 118.999Z</Geometry>
          <!-- the wordmark's letters, as drawn (in their drawing they start at 368, 53.712 and are 416 x 63.791) -->
          <GeometryGroup x:Key="Wordmark" FillRule="Nonzero">
            <PathGeometry FillRule="EvenOdd" Figures="M416.399 61.309V110.007L423.2 116.312H396.571L403.277 110.007V88.455H387.759V110.007L394.656 116.312H368.027L374.733 110.007V61.309L368.027 55.006H394.656L387.759 61.309V81.235H403.277V61.309L396.571 55.006H423.2L416.399 61.309Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M449.909 53.379C464.948 53.379 475.197 67.003 475.197 85.71 475.197 104.314 464.948 117.836 449.909 117.836 434.679 117.836 424.526 104.314 424.526 85.71 424.526 67.003 434.679 53.379 449.909 53.379ZM449.909 111.024C456.998 111.024 460.924 103.604 460.924 85.505 460.924 67.511 456.998 60.089 449.909 60.089 442.725 60.089 438.798 67.511 438.798 85.505 438.798 103.604 442.725 111.024 449.909 111.024ZM444.161 85.913L449.909 76.255 455.561 85.913 449.909 95.165 444.161 85.913Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M504.724 53.379C519.763 53.379 530.012 67.003 530.012 85.71 530.012 104.314 519.763 117.836 504.724 117.836 489.495 117.836 479.34 104.314 479.34 85.71 479.34 67.003 489.495 53.379 504.724 53.379ZM504.724 111.024C511.812 111.024 515.739 103.604 515.739 85.505 515.739 67.511 511.812 60.089 504.724 60.089 497.541 60.089 493.613 67.511 493.613 85.505 493.613 103.604 497.541 111.024 504.724 111.024ZM498.978 85.913L504.724 76.255 510.376 85.913 504.724 95.165 498.978 85.913Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M552.423 61.309V110.007L559.319 116.312H531.349L538.151 110.007V61.309L531.349 55.006H559.319L552.423 61.309ZM564.875 81.338L577.518 61.309 585.947 55.106H563.917L568.324 60.496 552.327 85.71 566.12 110.924 562.002 116.312H587.194L580.201 110.007 564.875 81.338Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M613.057 78.695C620.433 82.76 627.33 87.64 627.33 99.435 627.33 110.517 618.231 117.836 607.79 117.836 602.138 117.836 598.212 116.312 594.475 113.769L589.591 117.836 589.495 90.792C595.816 105.127 601.085 110.719 607.215 110.719 611.717 110.719 615.932 107.364 615.932 102.077 615.932 96.385 610.567 93.232 604.245 89.675 597.35 85.81 590.261 81.235 590.261 70.458 590.261 59.581 597.924 53.481 608.269 53.481 612.483 53.481 616.507 54.599 619.571 56.836L624.074 53.379V75.441C620.625 64.258 614.783 60.496 609.035 60.496 603.766 60.496 600.797 62.731 600.797 67.003 600.797 72.188 606.737 75.34 613.057 78.695Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M678.033 61.309V110.007L684.834 116.312H658.205L664.911 110.007V88.455H649.393V110.007L656.29 116.312H629.662L636.367 110.007V61.309L629.662 55.006H656.29L649.393 61.309V81.235H664.911V61.309L658.205 55.006H684.834L678.033 61.309Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M711.543 53.379C726.581 53.379 736.831 67.003 736.831 85.71 736.831 104.314 726.581 117.836 711.543 117.836 696.313 117.836 686.16 104.314 686.16 85.71 686.16 67.003 696.313 53.379 711.543 53.379ZM711.543 111.024C718.632 111.024 722.558 103.604 722.558 85.505 722.558 67.511 718.632 60.089 711.543 60.089 704.359 60.089 700.432 67.511 700.432 85.505 700.432 103.604 704.359 111.024 711.543 111.024ZM705.796 85.913L711.543 76.255 717.194 85.913 711.543 95.165 705.796 85.913Z"/>
            <PathGeometry FillRule="EvenOdd" Figures="M776.364 61.309H769.276V110.007L776.077 116.312H748.299L754.909 110.007V61.309H747.916L740.349 80.015V55.006H784.027V80.015L776.364 61.309Z"/>
          </GeometryGroup>
          <!-- the marks of the release rows, 24 x 24 (Heroicons' outline set, as drawn) -->
          <Geometry x:Key="TickMark">M4.5,12.75 l6,6 l9,-13.5</Geometry>
          <Geometry x:Key="DownloadMark">M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3</Geometry>
          <Geometry x:Key="RefreshMark">M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99</Geometry>
          <Geometry x:Key="DownMark">M19.5,8.25 l-7.5,7.5 l-7.5,-7.5</Geometry>
          <!-- the launcher's text: Segoe UI, 16 in a line of 20 -->
          <Style x:Key="Line" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
          </Style>
          <!-- the panel's small text: 12 in 16 -->
          <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
          </Style>
          <!-- (why something stopped: 13 in 18, in red) -->
          <Style x:Key="Why" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="#FF8373"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
          </Style>
          <!-- (the keyboard's place: a line around the button it is on) -->
          <Style x:Key="Ring" TargetType="Control">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate>
                  <Rectangle Stroke="#D2823F" StrokeThickness="1.5" RadiusX="3" RadiusY="3" Margin="-3"/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a button of the panel, 38 high with square-ish corners: Build Game, Check for updates, Update Available, the red
               one of a build or update that stopped (Background, Foreground and the word set where it is used) -->
          <Style x:Key="Block" TargetType="Button">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="All">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                    <Border x:Name="Shine" Background="#FFFFFF" CornerRadius="2" Opacity="0"/>
                    <TextBlock Text="{TemplateBinding Content}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                               Foreground="{TemplateBinding Foreground}" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.08"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.03"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="All" Property="Opacity" Value="0.4"/>
                      <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a box that shows what is chosen and changes it when pressed: the game file, the folder -->
          <Style x:Key="Field" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#5B5B5B"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,0">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="BorderBrush" Value="#8A8A8A"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a word that does something, small: Show details, Copy error log, Cancel -->
          <Style x:Key="SmallLink" TargetType="Button">
            <Setter Property="Foreground" Value="#B8B8B8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent">
                    <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <!-- the panel's three tabs: the one shown on the accent -->
          <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C5C5C5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Box" Background="Transparent" CornerRadius="2" Padding="0,4">
                    <TextBlock Style="{StaticResource Line}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#B86C00"/>
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a setting that is on or off: OFF | ON, the one it is on the accent -->
          <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                  <Border Background="#222222" BorderBrush="#5B5B5B" BorderThickness="1" Padding="4,5">
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="Off" Background="#B86C00" Height="20" Padding="4,0">
                        <TextBlock x:Name="OffText" Style="{StaticResource Small}" Text="OFF" VerticalAlignment="Center"/>
                      </Border>
                      <Border x:Name="On" Background="Transparent" Height="20" Padding="4,0" Margin="4,0,0,0">
                        <TextBlock x:Name="OnText" Style="{StaticResource Small}" Text="ON" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                      </Border>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Off" Property="Background" Value="Transparent"/>
                      <Setter TargetName="OffText" Property="Foreground" Value="#B0B0B0"/>
                      <Setter TargetName="On" Property="Background" Value="#B86C00"/>
                      <Setter TargetName="OnText" Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a build option picked from a list: what is picked and an arrow, at the right of its row, and the list under it -->
          <Style x:Key="DropItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D6D6D6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Box" Background="Transparent" Padding="10,6">
                    <TextBlock Text="{Binding}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Foreground" Value="#D2823F"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#2B2B2B"/>
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="Drop" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#D6D6D6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DropItem}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                  <Grid>
                    <ToggleButton Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="12,8">
                      <TextBlock Style="{StaticResource Small}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                 Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                      <Canvas Width="16" Height="16" Margin="21,0,0,0" VerticalAlignment="Center">
                        <Path Data="M13.313,5.844 l-5.313,5.312 l-5.312,-5.312" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{TemplateBinding Foreground}"/>
                      </Canvas>
                    </StackPanel>
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                      <Border Background="#1A1A1A" BorderBrush="#5B5B5B" BorderThickness="1" CornerRadius="2" Padding="2" Margin="0,2,0,0"
                              MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                        <ScrollViewer Style="{DynamicResource SlimScroll}" VerticalScrollBarVisibility="Auto">
                          <ItemsPresenter/>
                        </ScrollViewer>
                      </Border>
                    </Popup>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- the list the game file's box opens: the game files found (MainWindow.xaml.cs fills it) -->
          <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                  <Border Background="#1A1A1A" BorderBrush="#5B5B5B" BorderThickness="1" CornerRadius="2" Padding="2" MinWidth="235" MaxWidth="520">
                    <StackPanel IsItemsHost="True"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#D6D6D6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                  <Border x:Name="Box" Background="Transparent" Padding="10,7">
                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter Property="Foreground" Value="#D2823F"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#2B2B2B"/>
                      <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- Play: a torn strip, as drawn (257 x 98); faint while it cannot be pressed -->
          <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="All">
                    <Path x:Name="Strip" Stretch="Fill" Fill="#D2823F" Data="{StaticResource StripShape}"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Strip" Property="Fill" Value="#DC9150"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Strip" Property="Fill" Value="#BF7438"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="All" Property="Opacity" Value="0.2"/>
                      <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- Update beside Play when a newer release is out: the same torn strip, the panel's dark with the accent's words (it
               rebuilds the game, so it is the second choice, and Play stays the first) -->
          <Style x:Key="UpdateStrip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="All">
                    <Path x:Name="Strip" Stretch="Fill" Fill="#2B2B2B" Data="{StaticResource StripShape}"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Strip" Property="Fill" Value="#363636"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Strip" Property="Fill" Value="#222222"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="All" Property="Opacity" Value="0.2"/>
                      <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a word on the screen that does something: the version under Play (its folder), Credits -->
          <Style x:Key="Word" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="Transparent" CornerRadius="18">
                    <TextBlock Style="{StaticResource Line}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                               Margin="{TemplateBinding Padding}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="#1AFFFFFF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- Menu and Close menu: black, a mark before the word -->
          <Style x:Key="MarkBlock" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid>
                    <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                    <Border x:Name="Shine" Background="#FFFFFF" CornerRadius="2" Opacity="0"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Shine" Property="Opacity" Value="0.04"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a row of the panel's list: a version, the fold of the older ones -->
          <Style x:Key="Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <!-- (its text and its mark read the button's Foreground: white under the pointer) -->
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </Style.Triggers>
          </Style>
          <Style x:Key="FoldInk" TargetType="Button" BasedOn="{StaticResource Row}">
            <Setter Property="Foreground" Value="#8E8E8E"/>
          </Style>
          <!-- (its ink, LaunchList.cs: the version Play plays in green, one nothing can bring dim, the others quiet) -->
          <Style x:Key="VersionInk" TargetType="Button" BasedOn="{StaticResource Row}">
            <Setter Property="Foreground" Value="#BCBCBC"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Dim, Mode=OneTime}" Value="True">
                <Setter Property="Foreground" Value="#747474"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Ticked, Mode=OneTime}" Value="True">
                <Setter Property="Foreground" Value="#ACDF75"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
          <DataTemplate x:Key="VersionRow">
            <Button Style="{StaticResource VersionInk}" ToolTip="{Binding Tip, Mode=OneTime}" Click="LauncherRowClick"
                    AutomationProperties.Name="{Binding Label, Mode=OneTime}">
              <Grid Height="40" Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Line}" Text="{Binding Label, Mode=OneTime}" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <Canvas Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                  <Path Data="{StaticResource TickMark}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Visibility="{Binding Ticked, Mode=OneTime, Converter={StaticResource Shown}}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Path Data="{StaticResource DownloadMark}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Visibility="{Binding Arrow, Mode=OneTime, Converter={StaticResource Shown}}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Path Data="{StaticResource RefreshMark}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Visibility="{Binding Busy, Mode=OneTime, Converter={StaticResource Shown}}" Stroke="#BBBBBB"/>
                </Canvas>
              </Grid>
            </Button>
          </DataTemplate>
          <!-- the panel's own scroll bar: a thin thumb at its right edge, shown while the pointer is over the list -->
          <Style x:Key="SlimBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border CornerRadius="3" Background="#59FFFFFF"/>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="SlimScroll" TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                  <Grid Background="Transparent">
                    <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SlimBar}" HorizontalAlignment="Right" Margin="0,4,3,4" Opacity="0"
                               Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                               Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- the window's buttons, as Windows 11 draws its own: 48 x 48, the close button red under the pointer -->
          <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="Transparent">
                    <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#E6FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- a mark that opens a page (GitHub, Discord) -->
          <Style x:Key="MarkButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Ring}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Box" Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Box" Property="Opacity" Value="0.8"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Grid.Resources>

        <!-- (the page's own colour behind everything: no picture of the game ships with the launcher, which is the game's art.
             Original art takes its place here) -->

        <!-- the wordmark, in white, and what the game is -->
        <Viewbox Width="416" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,59,0,0" IsHitTestVisible="False">
          <Canvas Width="416" Height="63.791">
            <Path Data="{StaticResource Wordmark}" Fill="#FFFFFF">
              <Path.RenderTransform><TranslateTransform X="-368" Y="-53.712"/></Path.RenderTransform>
            </Path>
          </Canvas>
        </Viewbox>
        <TextBlock Style="{StaticResource Line}" Text="Ocarina of Time Remake Recomp" VerticalAlignment="Top"
                   HorizontalAlignment="Center" Margin="0,137,0,0" IsHitTestVisible="False"/>

        <!-- Play (Build while there is no game yet, which opens the build; faint while a build or an update runs) and the version it
             plays (pressed: its folder) -->
        <Button x:Name="LauncherGo" Style="{StaticResource PlayButton}" Width="257" Height="98" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="1,0,0,74" IsDefault="True" Click="LauncherGoClick" AutomationProperties.Name="{Binding Text, ElementName=LauncherGoText}">
          <TextBlock x:Name="LauncherGoText" Text="Play" FontFamily="{DynamicResource Serif}" FontSize="44" Foreground="#37291D">
            <TextBlock.RenderTransform><TranslateTransform x:Name="LauncherGoNudge"/></TextBlock.RenderTransform>
          </TextBlock>
        </Button>
        <!-- Update, beside Play while a newer release is out (Play then plays the version in the folder): Play keeps its place, as
             the menu's panel covers the screen's left -->
        <Button x:Name="LauncherUpdate" Style="{StaticResource UpdateStrip}" Width="150" Height="72" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,87" Click="UpdateClick" Visibility="Collapsed" AutomationProperties.Name="Update">
          <Button.RenderTransform><TranslateTransform X="217"/></Button.RenderTransform>
          <StackPanel>
            <TextBlock Text="Update" FontFamily="{DynamicResource Serif}" FontSize="30" Foreground="#D2823F" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LauncherUpdateTo" FontFamily="Segoe UI" FontSize="12" Foreground="#D2823F" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
          </StackPanel>
        </Button>
        <Button x:Name="LauncherVersion" Style="{StaticResource Word}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                ToolTip="Open the game folder" Click="LauncherFolderClick"/>

        <!-- what the hidden programs said, over the picture beside the menu: Show details -->
        <TextBox x:Name="Log" Visibility="Collapsed" Margin="284,170,16,180" IsReadOnly="True" BorderThickness="1" BorderBrush="#303030"
                 Background="#E0000000" Foreground="#BCBCBC" FontFamily="{StaticResource Mono}" FontSize="11" Padding="10"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

        <!-- the menu's button, at the top left while the menu is closed; its dot says an update is out -->
        <Button x:Name="MenuButton" Style="{StaticResource MarkBlock}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,72,0,0"
                Click="MenuClick" AutomationProperties.Name="Menu">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="20" Height="20" VerticalAlignment="Center">
              <Path Data="M3.125,5.625 h13.75 M3.125,10 h13.75 M3.125,14.375 h13.75" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <TextBlock Style="{StaticResource Line}" Text="Menu" Margin="8,0,0,0"/>
            <Ellipse x:Name="MenuDot" Width="8" Height="8" Fill="#D2823F" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
        </Button>

        <!-- Credits, GitHub and Discord, at the bottom right -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,24">
          <Button Style="{StaticResource Word}" Content="Credits" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Who made Hookshot"
                  Tag="https://github.com/NotRexed/Hookshot#credits" Click="LauncherLinkClick"/>
          <Button Style="{StaticResource MarkButton}" ToolTip="Hookshot on GitHub" AutomationProperties.Name="Hookshot on GitHub" Tag="https://github.com/NotRexed/Hookshot" Click="LauncherLinkClick">
            <Canvas Width="32" Height="32">
              <Path Fill="#FFFFFF" Data="M8 7.757C7.866 7.757 7.757 7.866 7.757 8 7.757 8.107 7.827 8.198 7.923 8.231 7.935 8.232 7.94 8.225 7.94 8.218
                    7.94 8.213 7.94 8.194 7.94 8.173 7.879 8.184 7.863 8.159 7.858 8.145 7.855 8.138 7.844 8.117 7.833 8.111 7.825 8.106 7.813 8.095
                    7.832 8.095 7.852 8.094 7.865 8.112 7.87 8.12 7.892 8.156 7.927 8.146 7.941 8.139 7.943 8.123 7.949 8.113 7.957 8.107 7.902 8.101
                    7.846 8.08 7.846 7.987 7.846 7.96 7.855 7.939 7.871 7.922 7.868 7.916 7.86 7.891 7.873 7.858 7.873 7.858 7.894 7.851 7.94 7.882
                    7.96 7.877 7.98 7.875 8.001 7.875 8.022 7.875 8.041 7.877 8.061 7.882 8.107 7.851 8.128 7.858 8.128 7.858 8.141 7.891 8.133 7.916
                    8.131 7.922 8.146 7.939 8.155 7.96 8.155 7.987 8.155 8.08 8.099 8.101 8.044 8.107 8.054 8.115 8.061 8.129 8.061 8.152 8.061 8.184

                    1.597-1.423 1.597z">
                <Path.RenderTransform><TranslateTransform X="-496" Y="-496"/></Path.RenderTransform>
              </Path>
            </Canvas>
          </Button>
        </StackPanel>

        <!-- ==== the menu: a panel from the left, 267 wide and a line (Paper: "Build Menu", "Releases Menu", "Settings Menu").
             Anywhere else in the window closes it ==== -->
        <Border x:Name="VersionBar" Visibility="Collapsed" HorizontalAlignment="Left" Width="268" Background="#F5000000"
                BorderBrush="#303030" BorderThickness="0,0,1,0" MouseLeftButtonDown="LauncherBarClick">
          <Border.RenderTransform><TranslateTransform x:Name="VersionBarSlide"/></Border.RenderTransform>
          <Grid Margin="0,42,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Style="{StaticResource MarkBlock}" Height="40" Padding="20,0" HorizontalContentAlignment="Left" Click="MenuCloseClick"
                    AutomationProperties.Name="Close menu">
              <StackPanel Orientation="Horizontal">
                <Canvas Width="24" Height="24" VerticalAlignment="Center">
                  <Path Data="M6,18 L18,6 M6,6 l12,12" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
                <TextBlock Style="{StaticResource Line}" Text="Close menu" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Grid Grid.Row="1" Margin="0,8,0,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <!-- the three tabs -->
              <Border Margin="16,0" Background="#2B2B2B" BorderBrush="#363636" BorderThickness="1" CornerRadius="2" Padding="4">
                <!-- (each as wide as its word and 12 either side, as drawn: 60, 84 and 81 of the 225) -->
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="60*"/><ColumnDefinition Width="84*"/><ColumnDefinition Width="81*"/></Grid.ColumnDefinitions>
                  <RadioButton x:Name="TabBuild" Style="{StaticResource Tab}" Content="Build" GroupName="Tabs" Checked="TabChecked"/>
                  <RadioButton x:Name="TabReleases" Grid.Column="1" Style="{StaticResource Tab}" Content="Releases" GroupName="Tabs" Checked="TabChecked"/>
                  <RadioButton x:Name="TabSettings" Grid.Column="2" Style="{StaticResource Tab}" Content="Settings" GroupName="Tabs" Checked="TabChecked"/>
                </Grid>
              </Border>

              <!-- ==== Build: the game file, the folder, Build Game; the build's options under them (Paper: "Build Menu";
                   while it builds "Build Menu - Building", when it stopped "Build Menu - Building Error") ==== -->
              <Grid x:Name="BuildPage" Grid.Row="1" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                  <StackPanel Margin="16,0">
                    <TextBlock Style="{StaticResource Small}" Text="Game File"/>
                    <Button x:Name="SourceChange" Style="{StaticResource Field}" Margin="0,8,0,0" Click="SourceChangeClick"
                            AutomationProperties.Name="Choose the game file">
                      <TextBlock x:Name="SourceText" Style="{StaticResource Small}" Foreground="#D6D6D6" Text="Browse files" HorizontalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock x:Name="SourceWhy" Style="{StaticResource Small}" Foreground="#FF8373" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                  <StackPanel Margin="16,8,16,0">
                    <TextBlock Style="{StaticResource Small}" Text="Install to"/>
                    <Button x:Name="ChangeButton" Style="{StaticResource Field}" Margin="0,8,0,0" Click="BrowseOut"
                            ToolTip="{Binding Text, ElementName=OutPath}" AutomationProperties.Name="Choose where the game is installed">
                      <TextBlock Style="{StaticResource Small}" Foreground="#D6D6D6" Text="{Binding Text, ElementName=OutPath}" HorizontalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <!-- (the folder itself: what the build and the launcher read; typed into nowhere, shown in the box above) -->
                    <TextBox x:Name="OutPath" Visibility="Collapsed" TextChanged="PathsChanged"/>
                  </StackPanel>
                  <!-- Build Game; the bar that fills in its place while it builds; the red button when it stopped -->
                  <Border x:Name="BuildArea" Margin="0,8,0,0" Padding="16" BorderBrush="#282828" BorderThickness="0,0,0,1">
                    <StackPanel>
                      <Grid>
                        <Button x:Name="BuildGame" Style="{StaticResource Block}" Background="#B86C00" Content="Build Game" Click="StartBuild"/>
                        <Grid x:Name="BuildBar" Height="38" Visibility="Collapsed">
                          <Border Background="#B4692A" CornerRadius="2"/>
                          <Rectangle x:Name="BuildFill" Fill="#D2823F" HorizontalAlignment="Left" Width="0" RadiusX="2" RadiusY="2"/>
                          <TextBlock x:Name="BuildBarText" Style="{StaticResource Line}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button x:Name="BuildStopped" Style="{StaticResource Block}" Background="#882D23" BorderBrush="#882D23" Content="Build stopped"
                                ToolTip="Try again" Visibility="Collapsed" Click="LauncherStoppedClick"/>
                      </Grid>
                      <TextBlock x:Name="BuildLine" Style="{StaticResource Small}" Foreground="#B8B8B8" HorizontalAlignment="Center" TextAlignment="Center"
                                 TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" Background="Transparent"/>
                      <TextBlock x:Name="BuildWhy" Style="{StaticResource Why}" Margin="0,8,0,0" MaxWidth="174" HorizontalAlignment="Left" Visibility="Collapsed"
                                 MaxHeight="162" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- the build's options (while nothing is under way) -->
                <StackPanel x:Name="BuildOptions" Grid.Row="1">
                  <TextBlock Style="{StaticResource Small}" Foreground="#B8B8B8" Text="Build options" Margin="16,0"/>
                  <Grid Margin="16,8,16,0" Height="32">
                    <TextBlock Style="{StaticResource Small}" Text="Language" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LanguageBox" Style="{StaticResource Drop}" AutomationProperties.Name="Game language" SelectionChanged="LanguageChanged"/>
                  </Grid>
                  <Grid Margin="16,8,16,0" Height="32">
                    <TextBlock x:Name="WorkerLabel" Style="{StaticResource Small}" Text="Workers" VerticalAlignment="Center"/>
                    <ComboBox x:Name="WorkerBox" Style="{StaticResource Drop}" IsEditable="False" AutomationProperties.Name="Build workers"
                              ToolTip="Automatic uses available memory and any existing worker override. More workers need more memory and may not be faster."/>
                  </Grid>
                  <Grid Margin="16,8,16,0" Height="32">
                    <TextBlock Style="{StaticResource Small}" Text="Memory" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MemoryBox" Style="{StaticResource Drop}" IsEditable="False" AutomationProperties.Name="Build memory"
                              ToolTip="How much memory the build may take, in GB. Automatic leaves free memory to your other programs. A number lets the compilers take that many GB together, even if your other programs need it: close them, or the PC may slow down."/>
                  </Grid>
                </StackPanel>
                <!-- (while it builds, or when it stopped: what the programs said, and Cancel or Copy error log) -->
                <StackPanel x:Name="BuildLinks" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,9" Visibility="Collapsed">
                  <Button x:Name="DetailsRow" Style="{StaticResource SmallLink}" Content="Show details" Click="DetailsClick"/>
                  <Button x:Name="BuildCancel" Style="{StaticResource SmallLink}" Content="Cancel" Margin="8,0,0,0" Click="LauncherCancelClick"/>
                  <Button x:Name="BuildCopy" Style="{StaticResource SmallLink}" Content="Copy error log" Margin="8,0,0,0" Click="StoppedCopyClick"/>
                </StackPanel>
              </Grid>

              <!-- ==== Releases: the versions, newest first (Paper: "Releases Menu") ==== -->
              <ScrollViewer x:Name="ReleasesPage" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource SlimScroll}" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel>
                  <ItemsControl x:Name="ReleaseList" ItemTemplate="{StaticResource VersionRow}" Focusable="False">
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,4"/></Style>
                    </ItemsControl.ItemContainerStyle>
                  </ItemsControl>
                  <!-- (the releases after the five newest, in one row until it is pressed) -->
                  <Button x:Name="FoldRow" Style="{StaticResource FoldInk}" Visibility="Collapsed" Click="LauncherFoldClick"
                          AutomationProperties.Name="{Binding Text, ElementName=FoldText}">
                    <Grid Height="40" Margin="16,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="FoldText" Style="{StaticResource Line}" VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <Canvas Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="FoldTurn"/></Canvas.RenderTransform>
                        <Path Data="{StaticResource DownMark}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </Canvas>
                    </Grid>
                  </Button>
                  <TextBlock x:Name="ReleasesNote" Style="{StaticResource Small}" Foreground="#B0B0B0" Margin="16,8,16,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
              </ScrollViewer>

              <!-- ==== Settings: what is on or off (Paper: "Settings Menu") ==== -->
              <StackPanel x:Name="SettingsPage" Grid.Row="1" Margin="16,12,16,0" Visibility="Collapsed">
                <Grid>
                  <TextBlock Style="{StaticResource Small}" Text="Prepare Shaders" VerticalAlignment="Center"/>
                  <!-- (make_game.py's last step, the game's prepare-shaders run: off, the game prepares them at its first start) -->
                  <CheckBox x:Name="PrepareTick" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="True" Click="SettingClick"
                            AutomationProperties.Name="Prepare shaders"
                            ToolTip="Prepares the game's shaders at the end of the build, a few minutes (longer on some GPUs). Off, the game prepares them at its first start, behind a black window."/>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <TextBlock Style="{StaticResource Small}" Text="Enable DLSS" VerticalAlignment="Center"/>
                  <!-- NVIDIA DLSS: off unless picked. Picking it shows NVIDIA's license; the build downloads NVIDIA's SDK under it
                       (make_game.py, scripts/ngx_sdk.py). Nothing of NVIDIA's comes with the builder -->
                  <CheckBox x:Name="DlssTick" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="False" Click="DlssChanged"
                            AutomationProperties.Name="NVIDIA DLSS"
                            ToolTip="For NVIDIA RTX graphics cards. The build downloads NVIDIA's SDK under NVIDIA's license. NVIDIA's files stay on this PC: never share a game folder built with them."/>
                </Grid>
                <!-- AMD FSR 4: off unless picked. Picking it shows AMD's license; the build downloads AMD's runtime under it
                     (make_game.py, scripts/ffx_sdk.py). Not in Paper's drawing; kept, as Hookshot's builder has it -->
                <Grid Margin="0,12,0,0">
                  <TextBlock Style="{StaticResource Small}" Text="Enable FSR 4" VerticalAlignment="Center"/>
                  <CheckBox x:Name="FsrTick" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="False" Click="FsrChanged"
                            AutomationProperties.Name="AMD FSR 4"
                            ToolTip="For AMD Radeon graphics cards. The build downloads AMD's runtime under AMD's license (asked when it is switched on). It is chosen in the game's Insert menu, as the Upscaler."/>
                </Grid>
                <!-- (#2206's RX_VK_PCACHE_LOAD=0, a line of the game folder's hookshot_env.txt, so it holds however the game is started:
                     GameEnv.cs. The game's own setting, not the build's: it takes effect at the next start, nothing is rebuilt) -->
                <Grid Margin="0,12,0,0">
                  <TextBlock Style="{StaticResource Small}" Text="Lower memory use" VerticalAlignment="Center"/>
                  <CheckBox x:Name="LowMemTick" Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="False" Click="LowMemClick"
                            AutomationProperties.Name="Lower memory use"
                            ToolTip="The game neither loads nor saves its pipeline cache file (mkw_vk_pipelines.bin), which the graphics driver holds in memory for the whole session: up to about 3 GB less memory. On a fresh driver cache the game may stutter more the first time it draws something. The file stays: switched off again, the game uses it as before. Applies from the game's next start, however it is started (a line in the game folder's hookshot_env.txt)."/>
                </Grid>
                <TextBlock x:Name="LowMemNote" Style="{StaticResource Small}" Foreground="#B0B0B0" Width="189" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"/>
                <!-- (#2447's Save my pipeline list: the game folder's list and the "Submit your pipelines" issue's report, zipped into
                     Downloads, LaunchShareClick. Only with a game folder: the list is the game's. The note under it says what it did) -->
                <Grid Margin="0,12,0,0">
                  <TextBlock Style="{StaticResource Small}" Text="Pipeline list" VerticalAlignment="Center"/>
                  <Button x:Name="LaunchShare" Style="{StaticResource SmallLink}" HorizontalAlignment="Right" Content="Save" Click="LaunchShareClick"
                          AutomationProperties.Name="Save my pipeline list"
                          ToolTip="Saves the list of pipelines your game made, and a filled-in report, as a zip for the &quot;Submit your pipelines&quot; issue. Nothing is uploaded."/>
                </Grid>
                <TextBlock x:Name="LaunchShareStatus" Style="{StaticResource Small}" Foreground="#B0B0B0" Width="189" HorizontalAlignment="Left"
                           TextWrapping="Wrap" Margin="0,4,0,0" Text="Helps remove stutter: a zip to attach to the Submit your pipelines issue."/>
                <!-- (Hookshot's update track, Updater.cs: off, Release; on, Release candidate. A Nightly chosen before shows on and stays
                     Nightly until it is switched) -->
                <Grid Margin="0,12,0,0">
                  <TextBlock Style="{StaticResource Small}" Text="Enable pre-releases" VerticalAlignment="Center"/>
                  <CheckBox x:Name="PreTick" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="PreClick"
                            AutomationProperties.Name="Enable pre-releases"/>
                </Grid>
                <TextBlock Style="{StaticResource Small}" Foreground="#B0B0B0" Width="189" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,4,0,0">
                  <Run Text="These versions contain the latest experimental features and changes, "/><Run Text="bugs may occur." Foreground="#E3B955"/>
                </TextBlock>
              </StackPanel>
            </Grid>

            <!-- ==== the foot: Check for updates; Update Available when there is one; the bar of an update under way, and Cancel;
                 the red button of one that stopped (Paper: "Releases Menu - Update Available", "Releases Menu - Updating") ==== -->
            <Border Grid.Row="2" BorderBrush="#282828" BorderThickness="0,1,0,0" Padding="16,16,16,0">
              <StackPanel>
                <!-- (a long reason is cut, whole under the pointer and in Show details: the buttons under it stay in the panel) -->
                <TextBlock x:Name="FootWhy" Style="{StaticResource Why}" Margin="0,0,0,8" Visibility="Collapsed" MaxHeight="108" TextTrimming="CharacterEllipsis"/>
                <Grid>
                  <Button x:Name="LauncherCheck" Style="{StaticResource Block}" Content="Check for updates" Click="LauncherCheckClick"/>
                  <Button x:Name="UpdateButton" Style="{StaticResource Block}" Background="#D2823F" Foreground="#000000" Content="Update Available"
                          Visibility="Collapsed" Click="UpdateClick"/>
                  <Grid x:Name="FootBar" Height="38" Visibility="Collapsed">
                    <Border Background="#B4692A" CornerRadius="2"/>
                    <Rectangle x:Name="FootFill" Fill="#D2823F" HorizontalAlignment="Left" Width="0" RadiusX="2" RadiusY="2"/>
                    <TextBlock x:Name="FootBarText" Style="{StaticResource Line}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <Button x:Name="FootStopped" Style="{StaticResource Block}" Background="#882D23" BorderBrush="#882D23" Content="Update stopped"
                          ToolTip="Try again" Visibility="Collapsed" Click="LauncherStoppedClick"/>
                </Grid>
                <TextBlock x:Name="FootLine" Style="{StaticResource Line}" FontSize="14" LineHeight="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Visibility="Collapsed"/>
                <!-- (not in Paper: that installing a version rebuilds the game, and how long it takes on this PC; while it runs, the step and the time left) -->
                <TextBlock x:Name="FootNote" Style="{StaticResource Small}" Foreground="#B8B8B8" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Button x:Name="FootCancel" Style="{StaticResource SmallLink}" Content="Cancel" Foreground="#BBBBBB" FontSize="14" FontWeight="SemiBold"
                        HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" Click="LauncherCancelClick"/>
                <StackPanel x:Name="FootLinks" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                  <Button x:Name="FootDetails" Style="{StaticResource SmallLink}" Content="Show details" Click="DetailsClick"/>
                  <Button x:Name="FootCopy" Style="{StaticResource SmallLink}" Content="Copy error log" Margin="8,0,0,0" Click="StoppedCopyClick"/>
                  <Button x:Name="FootDismiss" Style="{StaticResource SmallLink}" Content="Dismiss" Margin="8,0,0,0" Click="FootDismissClick"
                          ToolTip="Put this away: Check for updates in its place"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- the window's name, at the left of its top 48, over the menu as the drawing has it -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Height="48" Margin="16,0,0,0" IsHitTestVisible="False">
          <Image Source="pack://application:,,,/Images/hookshot.png" Width="16" Height="16" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Hookshot" FontFamily="Segoe UI" FontSize="12" Foreground="#E6FFFFFF" Margin="16,0,0,2" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- the launcher's own window buttons (it can be maximised: everything in it holds to an edge or the middle) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize"/>
          <Button x:Name="LauncherMax" Style="{StaticResource TitleButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="LauncherMaxClick"/>
          <Button Style="{StaticResource TitleButton}" Background="#C42B1C" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="CloseWindow"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

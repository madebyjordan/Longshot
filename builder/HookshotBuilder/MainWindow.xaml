                <Path.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleX="64" ScaleY="64"/>
                    <TranslateTransform X="-496" Y="-496"/>
                  </TransformGroup>
                </Path.RenderTransform>
              </Path>
            </Canvas>
          </Button>
          <Button Style="{StaticResource MarkButton}" Margin="10,0,0,0" ToolTip="Discord" AutomationProperties.Name="Discord" Tag="https://discord.gg/EajnD2AJD9" Click="LauncherLinkClick">
            <Canvas Width="32" Height="32">
              <Ellipse Canvas.Left="0.154" Canvas.Top="0.154" Width="31.692" Height="31.692" Fill="#5865F2"/>
              <Path Fill="#FFFFFF" Data="M517.491 506.955a13.067 13.067 0 0 0-3.225-1 0.049 0.049 0 0 0-0.052 0.024 9.102 9.102 0 0 0-0.403 0.826

                    1.597-1.423 1.597z">
                <Path.RenderTransform><TranslateTransform X="-496" Y="-496"/></Path.RenderTransform>
              </Path>
            </Canvas>
          </Button>
        </StackPanel>

        <!-- All Versions: the releases, the pre-releases and the dev builds, picked by a press (Paper: "v2 - Version List by channel").
             Anywhere else in the window closes it -->
        <Border x:Name="VersionBar" Visibility="Collapsed" HorizontalAlignment="Left" Width="224" Background="#B0000000"
                BorderBrush="#303030" BorderThickness="0,0,1,0" MouseLeftButtonDown="LauncherBarClick">
          <Border.RenderTransform><TranslateTransform x:Name="VersionBarSlide"/></Border.RenderTransform>
          <ScrollViewer x:Name="MenuScroll" Style="{StaticResource SlimScroll}" Margin="0,48,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,16,16,24">
              <Button Style="{StaticResource MarkPill}" Click="MenuCloseClick" AutomationProperties.Name="Close menu">
                <StackPanel Orientation="Horizontal">
                  <Canvas Width="24" Height="24" VerticalAlignment="Center">
                    <Path Data="M6,18 L18,6 M6,6 l12,12" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Canvas>
                  <TextBlock Style="{StaticResource Line}" Text="Close menu" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- ==== the build's options, while its choices are on the screen (Paper: "v3 - Build options") ==== -->
              <StackPanel x:Name="MenuOptions" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Line}" Text="Build options"/>
                <TextBlock Style="{StaticResource Line}" Text="Game language" Margin="0,40,0,12"/>
                <ComboBox x:Name="LanguageBox" Style="{StaticResource MenuChoice}" AutomationProperties.Name="Game language" SelectionChanged="LanguageChanged"/>
                <TextBlock x:Name="WorkerLabel" Style="{StaticResource Line}" Text="Build" Margin="0,40,0,12"/>
                <ComboBox x:Name="WorkerBox" Style="{StaticResource MenuChoice}" Tag="Workers: " IsEditable="False" AutomationProperties.Name="Build workers"
                          ToolTip="Automatic uses available memory and any existing worker override. More workers need more memory and may not be faster."/>
                <!-- (Hookshot's build memory choice, BuildWorkers.cs, as a row of this menu; not in Paper's drawing) -->
                <ComboBox x:Name="MemoryBox" Style="{StaticResource MenuChoice}" Tag="Memory: " IsEditable="False" Margin="0,4,0,0" AutomationProperties.Name="Build memory"
                          ToolTip="How much memory the build may take, in GB. Automatic leaves free memory to your other programs. A number lets the compilers take that many GB together, even if your other programs need it: close them, or the PC may slow down."/>
                <!-- the build files: how much and where (Storage.cs) under the pointer, and choosing the place by a press -->
                <Button x:Name="WorkChange" Style="{StaticResource RowInk}" Margin="0,4,0,0" Click="BrowseWork" AutomationProperties.Name="Where the build files are kept">
                  <Button.ToolTip>
                    <TextBlock x:Name="WorkNote" MaxWidth="380" TextWrapping="Wrap"/>
                  </Button.ToolTip>
                  <Grid Height="40">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="WorkText" Style="{StaticResource Line}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Canvas Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                      <Path Data="M19.5,8.25 l-7.5,7.5 l-7.5,-7.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Canvas>
                  </Grid>
                </Button>
                <Button x:Name="WorkReset" Style="{StaticResource FoldInk}" Margin="0,4,0,0" Visibility="Collapsed" Click="ResetWork"
                        AutomationProperties.Name="Keep the build files in the usual place">
                  <Grid Height="40">
                    <TextBlock Style="{StaticResource Line}" Text="Back to the usual place" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </Grid>
                </Button>
                <TextBlock Style="{StaticResource Line}" Text="Extras" Margin="0,40,0,12"/>
                <!-- (make_game.py's last step, the game's prepare-shaders run: off, the game prepares them at its first start) -->
                <CheckBox x:Name="PrepareTick" Style="{StaticResource MenuTick}" Content="Prepare shaders now" IsChecked="True"
                          ToolTip="Prepares the game's shaders at the end of the build, a few minutes (longer on some GPUs). Off, the game prepares them at its first start, behind a black window."/>
                <!-- NVIDIA DLSS: off unless picked. Picking it shows NVIDIA's license; the build downloads NVIDIA's SDK under it
                     (make_game.py, scripts/ngx_sdk.py). Nothing of NVIDIA's comes with the builder -->
                <CheckBox x:Name="DlssTick" Style="{StaticResource MenuTick}" Content="NVIDIA DLSS" IsChecked="False" Margin="0,4,0,0" Click="DlssChanged"
                          ToolTip="For NVIDIA RTX graphics cards. The build downloads NVIDIA's SDK under NVIDIA's license. NVIDIA's files stay on this PC: never share a game folder built with them."/>
                <!-- AMD FSR 4: off unless picked. Nothing is downloaded: AMD's DLLs are put beside the game by hand (the readme) -->
                <CheckBox x:Name="FsrTick" Style="{StaticResource MenuTick}" Content="AMD FSR 4" IsChecked="False" Margin="0,4,0,0"
                          ToolTip="For AMD Radeon graphics cards. AMD's files are not included: see the readme. It is chosen in the game's Insert menu, as the Upscaler."/>
              </StackPanel>

              <!-- ==== the steps of what is being built or brought, while it is (Paper: "v3 - Building") ==== -->
              <StackPanel x:Name="MenuSteps" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StepsTitle" Style="{StaticResource Line}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource Line}" Text="Steps" Margin="0,40,0,12"/>
                <StackPanel x:Name="StageList"/>
                <Button x:Name="DetailsRow" Style="{StaticResource FoldInk}" Margin="0,40,0,0" Click="DetailsClick"
                        AutomationProperties.Name="{Binding Text, ElementName=DetailsText}">
                  <Grid Height="40">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailsText" Style="{StaticResource Line}" Text="Show details" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Canvas Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                      <Canvas.RenderTransform><ScaleTransform x:Name="DetailsTurn"/></Canvas.RenderTransform>
                      <Path Data="M19.5,8.25 l-7.5,7.5 l-7.5,-7.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Canvas>
                  </Grid>
                </Button>
              </StackPanel>

              <!-- ==== the versions (Paper: "Master Menu", "v2 - Menu: versions by channel") ==== -->
              <StackPanel x:Name="MenuVersions" Margin="0,40,0,0">
              <TextBlock Style="{StaticResource Line}" Text="All Versions"/>
              <Button x:Name="LauncherCheck" Style="{StaticResource Pill}" Background="{StaticResource Leather}" Content="Check for updates"
                      MinWidth="176" HorizontalAlignment="Left" Margin="0,12,0,0" Click="LauncherCheckClick"/>
              <!-- (a list with nothing in it is not shown: most players see Releases alone) -->
              <StackPanel x:Name="ReleaseVersions" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Line}" Text="Releases"/>
                <ItemsControl x:Name="ReleaseList" ItemTemplate="{StaticResource VersionRow}" Margin="0,12,0,-4" Focusable="False">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,4"/></Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <!-- (the releases before the two newest, in one row until it is pressed) -->
                <Button x:Name="FoldRow" Style="{StaticResource FoldInk}" Margin="0,4,0,0" Visibility="Collapsed" Click="LauncherFoldClick"
                        AutomationProperties.Name="{Binding Text, ElementName=FoldText}">
                  <Grid Height="40">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="FoldText" Style="{StaticResource Line}" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Canvas Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                      <Canvas.RenderTransform><ScaleTransform x:Name="FoldTurn"/></Canvas.RenderTransform>
                      <Path Data="M19.5,8.25 l-7.5,7.5 l-7.5,-7.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Canvas>
                  </Grid>
                </Button>
              </StackPanel>
              <StackPanel x:Name="PreVersions" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Line}" Text="Pre-releases"/>
                <ItemsControl x:Name="PreList" ItemTemplate="{StaticResource VersionRow}" Margin="0,12,0,-4" Focusable="False">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,4"/></Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
              </StackPanel>
              <StackPanel x:Name="DevVersions" Margin="0,40,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Line}" Text="Dev builds"/>
                <ItemsControl x:Name="DevList" ItemTemplate="{StaticResource VersionRow}" Margin="0,12,0,-4" Focusable="False">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,4"/></Style>
                  </ItemsControl.ItemContainerStyle>
                </ItemsControl>
              </StackPanel>
              <!-- (the builder's own pages: a build from other game files, the options a build has) -->
              <Button x:Name="LauncherBuild" Style="{StaticResource FoldInk}" Margin="0,40,0,0" Click="LauncherBuildClick"
                      AutomationProperties.Name="Build from game files">
                <Grid Height="40">
                  <TextBlock Style="{StaticResource Line}" Text="Build from game files" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Grid>
              </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- the window's name, at the left of its top 48, over the bar of versions as the drawing has it -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Height="48" Margin="16,0,0,0" IsHitTestVisible="False">
          <Image Source="pack://application:,,,/Images/longshot.png" Width="16" Height="16" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Longshot" FontFamily="Segoe UI" FontSize="12" Foreground="#E6FFFFFF" Margin="16,0,0,2" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- the launcher's own window buttons (it can be maximised: everything in it holds to an edge or the middle) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize"/>
          <Button x:Name="LauncherMax" Style="{StaticResource TitleButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="LauncherMaxClick"/>
          <Button Style="{StaticResource TitleButton}" Background="#C42B1C" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="CloseWindow"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

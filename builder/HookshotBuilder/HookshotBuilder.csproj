<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LongshotBuilder</AssemblyName>
    <RootNamespace>HookshotBuilder</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Longshot Builder</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\setup\longshot.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Needs nothing installed: dotnet publish -c Release. A folder (the app and .NET's own signed files), not one compressed exe:
       antivirus programs took the self-extracting single file for a trojan and removed it -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Inter and Marcellus (SIL Open Font License, Fonts/*-LICENSE.txt) and the hookshot, inside the app -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Images\longshot.png" />
    <None Include="Fonts\*-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
